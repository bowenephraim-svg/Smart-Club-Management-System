<%- include('../partials/header') %>

<div class="app-layout-container">
    <%- include('../partials/sidebar') %>

    <div class="main-content-window">

    <%- include('../partials/navbar') %>

    <main class="workspace-viewport">

        <div class="page-header-actions">

            <div class="header-text-block">

                <h2>My Notifications</h2>

                <p>Your latest system alerts and announcements.</p>

            </div>

            <% if (unread > 0) { %>
                <a
                    href="/notifications/read-all"
                    class="btn btn-success">

                    <i class="fas fa-check-double"></i>

                    Mark All Read

                </a>
            <% } %>

        </div>

        <div class="dashboard-stats-grid">

            <div class="stat-card">

                <div class="stat-icon-wrapper"
                    style="background:rgba(59,130,246,.15);color:#3b82f6;">

                    <i class="fas fa-bell"></i>

                </div>

                <div class="stat-data-block">

                    <h3><%= notifications.length %></h3>

                    <p>Total Notifications</p>

                </div>

            </div>

            <div class="stat-card">

                <div class="stat-icon-wrapper"
                    style="background:rgba(245,158,11,.15);color:#f59e0b;">

                    <i class="fas fa-envelope"></i>

                </div>

                <div class="stat-data-block">

                    <h3><%= unread %></h3>

                    <p>Unread</p>

                </div>

            </div>

        </div>

        <% if (notifications.length === 0) { %>

            <div class="notification-center-empty">

                <i class="fas fa-bell-slash"></i>

                <h3>No Notifications</h3>

                <p>You're all caught up. New notifications will appear here.</p>

            </div>

        <% } else { %>

            <div class="notification-center-list">

                <% notifications.forEach(notification => { %>

                    <div class="notification-center-item <%= notification.status === 'Unread' ? 'unread' : '' %>"
                         data-id="<%= notification.notification_id %>">

                        <div class="notification-center-icon <%= notification.type %>">

                            <% if (notification.type === 'student_registration') { %>
                                <i class="fas fa-user-plus"></i>
                            <% } else if (notification.type === 'membership_pending') { %>
                                <i class="fas fa-hourglass-half"></i>
                            <% } else if (notification.type === 'membership_approved') { %>
                                <i class="fas fa-check-circle"></i>
                            <% } else if (notification.type === 'membership_rejected') { %>
                                <i class="fas fa-times-circle"></i>
                            <% } else if (notification.type === 'payment_received') { %>
                                <i class="fas fa-money-bill-wave"></i>
                            <% } else if (notification.type === 'activity_created') { %>
                                <i class="fas fa-calendar-plus"></i>
                            <% } else if (notification.type === 'feedback_received') { %>
                                <i class="fas fa-comment-dots"></i>
                            <% } else if (notification.type === 'announcement_created') { %>
                                <i class="fas fa-bullhorn"></i>
                            <% } else { %>
                                <i class="fas fa-bell"></i>
                            <% } %>

                        </div>

                        <div class="notification-center-content">

                            <p class="notification-center-message">
                                <%= notification.message %>
                            </p>

                            <span class="notification-center-time">
                                <i class="fas fa-clock"></i>
                                <%= new Date(notification.created_at).toLocaleString() %>
                            </span>

                        </div>

                        <div class="notification-center-status">

                            <% if (notification.status === 'Unread') { %>

                                <span class="badge bg-warning">Unread</span>

                                <a
                                    href="/notifications/read/<%= notification.notification_id %>"
                                    class="btn btn-success btn-sm notification-mark-read-btn">

                                    Mark Read

                                </a>

                            <% } else { %>

                                <span class="badge bg-success">Read</span>

                            <% } %>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </main>

    <%- include('../partials/footer') %>

    </div>
</div>