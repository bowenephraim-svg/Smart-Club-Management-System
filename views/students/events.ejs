<!DOCTYPE html>
<html lang="en">

<head>

    <link rel="icon" type="image/svg+xml" href="<%= schoolSettings && schoolSettings.school_logo ? schoolSettings.school_logo : '/images/favicon.svg' %>">

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        Events |
        <%= schoolSettings
            ? (schoolSettings.school_name || 'Smart Club System')
            : 'Smart Club System' %>
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/student.css"
    >

</head>

<body>

<div class="student-layout">

    <!-- =====================================================
         STUDENT SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <div class="logo">

            <h4>
                <%= schoolSettings
                    ? (schoolSettings.school_name || 'Smart Club System')
                    : 'Smart Club System' %>
            </h4>

            <small>Student Portal</small>

        </div>


        <ul>

            <li>
                <a href="/student/dashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
            </li>


            <li>
                <a href="/student/clubs">
                    <i class="bi bi-people"></i>
                    <span>My Clubs</span>
                </a>
            </li>


            <li>
                <a href="/student/payments">
                    <i class="bi bi-cash-stack"></i>
                    <span>My Payments</span>
                </a>
            </li>


            <li class="active">
                <a href="/student/events">
                    <i class="bi bi-calendar-event"></i>
                    <span>Events</span>
                </a>
            </li>


            <li>
                <a href="/student/attendance">
                    <i class="bi bi-check2-square"></i>
                    <span>Attendance</span>
                </a>
            </li>


            <li>
                <a href="/student/notifications">
                    <i class="bi bi-bell"></i>
                    <span>Notifications</span>
                </a>
            </li>


            <li>
                <a href="/elections/available">
                    <i class="bi bi-check2-square"></i>
                    <span>Elections</span>
                </a>
            </li>


            <li>
                <a href="/student/profile">
                    <i class="bi bi-person-circle"></i>
                    <span>My Profile</span>
                </a>
            </li>


            <li>
                <a href="/auth/logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </li>

        </ul>

    </aside>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="content">


        <!-- TOPBAR -->

        <div class="topbar">

            <div>

                <h3>Upcoming Events</h3>

                <small>
                    View upcoming club activities and events.
                </small>

            </div>


            <div class="profile">

                <img
                    src="<%= (typeof student !== 'undefined' && student && student.profile_image) || (typeof user !== 'undefined' && user && user.profile_image) || '/images/default-avatar.png' %>"
                    alt="Student Profile"
                >

            </div>

        </div>


        <!-- =================================================
             HEADER CARD
        ================================================== -->

        <div class="welcome-card">

            <h2>

                <i class="bi bi-calendar-event"></i>

                Club Events & Activities

            </h2>

            <p>

                Stay informed about upcoming activities,
                meetings and events in the school clubs.

            </p>

        </div>


        <!-- =================================================
             EVENTS
        ================================================== -->

        <% if (activities && activities.length > 0) { %>


            <div class="cards">

                <% activities.forEach(activity => { %>

                    <div class="card-box text-start">

                        <div class="mb-3">

                            <i
                                class="bi bi-calendar-event"
                                style="font-size:40px;"
                            ></i>

                        </div>


                        <h4>

                            <%= activity.title || activity.activity_name || 'Club Activity' %>

                        </h4>


                        <p>

                            <i class="bi bi-calendar3"></i>

                            <strong>Date:</strong>

                            <%= activity.activity_date
                                ? new Date(activity.activity_date).toLocaleDateString()
                                : 'Date not available' %>

                        </p>


                        <p>

                            <i class="bi bi-geo-alt"></i>

                            <strong>Venue:</strong>

                            <%= activity.venue || 'Venue not specified' %>

                        </p>


                        <% if (activity.description) { %>

                            <p class="text-muted">

                                <%= activity.description %>

                            </p>

                        <% } %>


                    </div>

                <% }) %>

            </div>


        <% } else { %>


            <!-- EMPTY STATE -->

            <div class="section text-center">

                <i
                    class="bi bi-calendar-x"
                    style="font-size:70px;color:#94a3b8;"
                ></i>


                <h3 class="mt-3">

                    No Upcoming Events

                </h3>


                <p class="text-muted">

                    There are currently no upcoming club activities
                    or events.

                </p>


                <a
                    href="/student/dashboard"
                    class="btn btn-primary"
                >

                    <i class="bi bi-arrow-left"></i>

                    Back to Dashboard

                </a>

            </div>


        <% } %>


    </main>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js">
</script>

<script src="/js/theme.js"></script>
</body>

</html>
