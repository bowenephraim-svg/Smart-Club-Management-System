<!DOCTYPE html>
<html lang="en">

<head>

    <link rel="icon" type="image/svg+xml" href="<%= schoolSettings && schoolSettings.school_logo ? schoolSettings.school_logo : '/images/favicon.svg' %>">

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Join a Club |
        <%= schoolSettings
            ? (schoolSettings.school_name || 'Smart Club System')
            : 'Smart Club System'
        %>
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/student.css"
    >

</head>


<body>

<div class="student-layout">


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <div class="logo">

            <h4>
                <%= schoolSettings
                    ? (schoolSettings.school_name || 'Smart Club System')
                    : 'Smart Club System'
                %>
            </h4>

            <small>
                Student Portal
            </small>

        </div>


        <ul>

            <li>

                <a href="/student/dashboard">

                    <i class="bi bi-speedometer2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/clubs">

                    <i class="bi bi-people"></i>

                    <span>
                        My Clubs
                    </span>

                </a>

            </li>


            <li class="active">

                <a href="/student/clubs/available">

                    <i class="bi bi-plus-circle"></i>

                    <span>
                        Join a Club
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/payments">

                    <i class="bi bi-cash-stack"></i>

                    <span>
                        My Payments
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/events">

                    <i class="bi bi-calendar-event"></i>

                    <span>
                        Events
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/attendance">

                    <i class="bi bi-check2-square"></i>

                    <span>
                        Attendance
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/notifications">

                    <i class="bi bi-bell"></i>

                    <span>
                        Notifications
                    </span>

                </a>

            </li>


            <li>

                <a href="/elections/available">

                    <i class="bi bi-check2-square"></i>

                    <span>
                        Elections
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/profile">

                    <i class="bi bi-person-circle"></i>

                    <span>
                        My Profile
                    </span>

                </a>

            </li>


            <li>

                <a href="/auth/logout">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </li>

        </ul>

    </aside>



    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="content">

        <% if (typeof error_msg !== 'undefined' && error_msg) { %>
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <%= error_msg %>
            </div>
        <% } %>

        <% if (typeof success_msg !== 'undefined' && success_msg) { %>
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <%= success_msg %>
            </div>
        <% } %>


        <!-- TOPBAR -->

        <div class="topbar">

            <div>

                <h3>
                    Join a Club
                </h3>

                <small>
                    Choose a club you would like to join.
                </small>

            </div>


            <div class="profile">

                <img
                    src="<%= (typeof student !== 'undefined' && student && student.profile_image) || (typeof user !== 'undefined' && user && user.profile_image) || '/images/default-avatar.png' %>"
                    alt="Student Profile"
                >

            </div>

        </div>



        <!-- =================================================
             FLASH MESSAGES
        ================================================== -->

        <% if (success_msg) { %>

            <div
                class="alert alert-success alert-dismissible fade show"
                role="alert"
            >

                <i class="bi bi-check-circle-fill me-2"></i>

                <%= success_msg %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% } %>


        <% if (error_msg) { %>

            <div
                class="alert alert-danger alert-dismissible fade show"
                role="alert"
            >

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                <%= error_msg %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% } %>



        <!-- =================================================
             INTRO CARD
        ================================================== -->

        <div class="welcome-card">

            <h2>

                <i class="bi bi-people-fill me-2"></i>

                Available Clubs

            </h2>

            <p>

                Explore the clubs available at
                <%= schoolSettings
                    ? (schoolSettings.school_name || 'Smart Club System')
                    : 'Smart Club System'
                %>
                and choose one that interests you.

            </p>

            <p class="mb-0">

                <strong>
                    Note:
                </strong>

                Your KES 500 registration fee is separate
                from club membership fees.

            </p>

        </div>



        <!-- =================================================
             CLUB GRID
        ================================================== -->

        <div class="row g-4 mt-2">


            <% if (clubs && clubs.length > 0) { %>


                <% clubs.forEach(club => { %>

                    <div class="col-md-6 col-lg-4">


                        <div class="card h-100 shadow-sm border-0">


                            <div class="card-body d-flex flex-column">


                                <!-- Club icon -->

                                <div class="mb-3">

                                    <div
                                        style="
                                            width:55px;
                                            height:55px;
                                            border-radius:14px;
                                            display:flex;
                                            align-items:center;
                                            justify-content:center;
                                            background:#eef2ff;
                                            color:#4f46e5;
                                            font-size:25px;
                                        "
                                    >

                                        <i class="bi bi-people-fill"></i>

                                    </div>

                                </div>


                                <!-- Club name -->

                                <h4 class="card-title">

                                    <%= club.club_name %>

                                </h4>


                                <!-- Description -->

                                <p class="text-muted">

                                    <%= club.description ||
                                        'No description available.' %>

                                </p>


                                <!-- Details -->

                                <div class="mb-3">


                                    <% if (club.patron_name) { %>

                                        <div class="small mb-2">

                                            <i class="bi bi-person-badge me-2"></i>

                                            <strong>
                                                Patron:
                                            </strong>

                                            <%= club.patron_name %>

                                        </div>

                                    <% } %>


                                    <% if (club.meeting_day) { %>

                                        <div class="small mb-2">

                                            <i class="bi bi-calendar3 me-2"></i>

                                            <strong>
                                                Meeting:
                                            </strong>

                                            <%= club.meeting_day %>

                                        </div>

                                    <% } %>


                                    <% if (club.venue) { %>

                                        <div class="small mb-2">

                                            <i class="bi bi-geo-alt me-2"></i>

                                            <strong>
                                                Venue:
                                            </strong>

                                            <%= club.venue %>

                                        </div>

                                    <% } %>


                                    <div class="small mb-2">

                                        <i class="bi bi-cash-stack me-2"></i>

                                        <strong>
                                            Membership Fee:
                                        </strong>


                                        <% if (
                                            Number(club.membership_fee || 0) > 0
                                        ) { %>

                                            KES
                                            <%= Number(
                                                club.membership_fee
                                            ).toLocaleString() %>

                                        <% } else { %>

                                            <span class="text-success">
                                                FREE
                                            </span>

                                        <% } %>

                                    </div>

                                </div>


                                <!-- Existing membership -->

                                <% if (club.membership_status === 'Active') { %>

                                    <button
                                        class="btn btn-success mt-auto"
                                        disabled
                                    >

                                        <i class="bi bi-check-circle me-1"></i>

                                        Already a Member

                                    </button>


                                <% } else if (
                                    club.membership_status === 'Pending'
                                ) { %>

                                    <button
                                        class="btn btn-warning mt-auto"
                                        disabled
                                    >

                                        <i class="bi bi-clock me-1"></i>

                                        Request Pending

                                    </button>


                                <% } else if (
                                    club.membership_status === 'Rejected'
                                ) { %>

                                    <a
                                        href="/student/clubs/<%= club.club_id %>/payment"
                                        class="btn btn-primary mt-auto"
                                    >

                                        <i class="bi bi-arrow-repeat me-1"></i>

                                        Try Again

                                    </a>


                                <% } else { %>


                                    <a
                                        href="/student/clubs/<%= club.club_id %>/payment"
                                        class="btn btn-primary mt-auto"
                                    >

                                        <i class="bi bi-person-plus me-1"></i>


                                        <% if (
                                            Number(club.membership_fee || 0) > 0
                                        ) { %>

                                            Join Club

                                        <% } else { %>

                                            Join Free

                                        <% } %>

                                    </a>


                                <% } %>


                            </div>

                        </div>


                    </div>

                <% }) %>


            <% } else { %>


                <!-- No clubs -->

                <div class="col-12">

                    <div class="text-center py-5">


                        <i
                            class="bi bi-people"
                            style="
                                font-size:60px;
                                color:#94a3b8;
                            "
                        ></i>


                        <h4 class="mt-3">

                            No Clubs Available

                        </h4>


                        <p class="text-muted">

                            There are currently no clubs available
                            for membership.

                        </p>


                    </div>

                </div>


            <% } %>


        </div>


    </main>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
></script>


<script src="/js/theme.js"></script>
</body>

</html>
