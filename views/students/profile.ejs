<!DOCTYPE html>
<html lang="en">

<head>

    <link rel="icon" type="image/svg+xml" href="<%= schoolSettings && schoolSettings.school_logo ? schoolSettings.school_logo : '/images/favicon.svg' %>">

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        My Profile |
        <%= schoolSettings
            ? (schoolSettings.school_name || 'Smart Club System')
            : 'Smart Club System' %>
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/student.css">
    <link rel="stylesheet" href="/css/design-system.css">

</head>

<body>
<script>
    try { if (localStorage.getItem('victory-theme') === 'dark') document.body.classList.add('dark-theme'); } catch (_) {}
</script>

<div class="student-layout">

    <!-- STUDENT SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <h4>
                <%= schoolSettings
                    ? (schoolSettings.school_name || 'Smart Club System')
                    : 'Smart Club System' %>
            </h4>

            <small>Student Portal</small>

        </div>

        <ul>

            <li>
                <a href="/student/dashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            
            <li>
              <a href="/student/clubs/available">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>Join a Club</span>
              </a>
            </li>


            <li>
                <a href="/student/payments">
                    <i class="bi bi-cash-stack"></i>
                    <span>My Payments</span>
                </a>
            </li>

            <li>
                <a href="/student/events">
                    <i class="bi bi-calendar-event"></i>
                    <span>Events</span>
                </a>
            </li>

            <li>
                <a href="/student/attendance">
                    <i class="bi bi-check2-square"></i>
                    <span>Attendance</span>
                </a>
            </li>

            <li>
                <a href="/student/notifications">
                    <i class="bi bi-bell"></i>
                    <span>Notifications</span>
                </a>
            </li>

            <li>
                <a href="/elections/available">
                    <i class="bi bi-check2-square"></i>
                    <span>Elections</span>
                </a>
            </li>

            <li class="active">
                <a href="/student/profile">
                    <i class="bi bi-person-circle"></i>
                    <span>My Profile</span>
                </a>
            </li>

            <li>
                <a href="/auth/logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </li>

        </ul>

    </aside>


    <!-- MAIN CONTENT -->

    <main class="content">

        <div class="topbar">

            <div>

                <h3>My Profile</h3>

                <small>
                    View your student information and activity.
                </small>

            </div>

            <div class="profile">

                <img
                    src="<%= student.profile_image || '/images/default-avatar.png' %>"
                    alt="Student Profile">

            </div>

        </div>


        <!-- PROFILE -->

        <div class="profile-page">

            <div class="text-center mb-4">

                <img
                    src="<%= student.profile_image || '/images/default-avatar.png' %>"
                    class="profile-avatar-large"
                    alt="Student Profile"
                    data-profile-preview>

                <form action="/student/profile/image" method="POST" enctype="multipart/form-data" class="mt-3">
                    <label for="studentProfileImage" class="btn btn-primary btn-sm profile-upload-control">
                        <i class="bi bi-camera"></i> Choose Profile Image
                    </label>
                    <input id="studentProfileImage" type="file" name="profile_image" accept="image/jpeg,image/png,image/webp" required style="display:none;" onchange="this.form.submit()">
                </form>

                <h2 class="mt-3">
                    <%= student.first_name %>
                    <%= student.last_name %>
                </h2>

                <p class="text-muted">
                    Student
                </p>

            </div>


            <div class="row g-4">

                <div class="col-md-6">

                    <div class="card h-100">

                        <div class="card-body">

                            <h5>
                                <i class="bi bi-person"></i>
                                Personal Information
                            </h5>

                            <hr>

                            <p>
                                <strong>First Name:</strong>
                                <%= student.first_name %>
                            </p>

                            <p>
                                <strong>Last Name:</strong>
                                <%= student.last_name %>
                            </p>

                            <p>
                                <strong>Email:</strong>
                                <%= student.email %>
                            </p>

                            <p>
                                <strong>Phone:</strong>
                                <%= student.phone || 'Not provided' %>
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="card h-100">

                        <div class="card-body">

                            <h5>
                                <i class="bi bi-mortarboard"></i>
                                Academic Information
                            </h5>

                            <hr>

                            <p>
                                <strong>Admission Number:</strong>
                                <%= student.admission_no %>
                            </p>

                            <p>
                                <strong>Class:</strong>
                                <%= student.class %>
                            </p>

                            <p>
                                <strong>Stream:</strong>
                                <%= student.stream %>
                            </p>

                            <p>
                                <strong>Status:</strong>

                                <% if (student.status === 'Active') { %>

                                    <span class="badge bg-success">
                                        Active
                                    </span>

                                <% } else { %>

                                    <span class="badge bg-warning">
                                        <%= student.status %>
                                    </span>

                                <% } %>

                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ATTENDANCE -->

            <div class="mt-4">

                <h5 class="mb-3">
                    <i class="bi bi-calendar-check"></i>
                    Recent Attendance
                </h5>

                <div class="table-responsive">

                    <table class="table">

                        <thead>

                            <tr>
                                <th>Activity</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                        <% if (attendance && attendance.length > 0) { %>

                            <% attendance.forEach(record => { %>

                                <tr>

                                    <td>
                                        <%= record.title || 'Activity' %>
                                    </td>

                                    <td>
                                        <%= new Date(record.meeting_date).toLocaleDateString() %>
                                    </td>

                                    <td>

                                        <% if (record.status === 'Present') { %>

                                            <span class="badge bg-success">
                                                Present
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-danger">
                                                <%= record.status %>
                                            </span>

                                        <% } %>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>

                                <td colspan="3" class="text-center">

                                    No attendance records available.

                                </td>

                            </tr>

                        <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </main>

</div>

<script src="/js/theme.js"></script>
</body>
</html>
