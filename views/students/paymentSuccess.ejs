<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/svg+xml" href="<%= schoolSettings && schoolSettings.school_logo ? schoolSettings.school_logo : '/images/favicon.svg' %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Received | Victory School</title>
    <link rel="stylesheet" href="/css/design-system.css">
    <style>
        .success-page-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--background);
            padding: 24px;
        }

        .success-card {
            width: 100%;
            max-width: 520px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            overflow: hidden;
            text-align: center;
        }

        .success-card-header {
            padding: 28px 28px 0;
        }

        .success-icon {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: #dcfce7;
            color: #15803d;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin-bottom: 16px;
        }

        .success-card-header h1 {
            margin: 0;
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .success-card-header p {
            margin: 8px 0 0;
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.5;
        }

        .success-card-body {
            padding: 20px 28px 28px;
        }

        .success-student-name {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 6px;
        }

        .success-meta {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin: 0 0 20px;
        }

        .success-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .success-actions .btn {
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="success-page-shell">
        <div class="success-card">
            <div class="success-card-header">
                <div class="success-icon">
                    <i class="fas fa-check"></i>
                </div>
                <h1>Payment Received</h1>
                <p>Your registration payment has been received successfully.</p>
            </div>

            <div class="success-card-body">
                <p class="success-student-name">
                    <%= student.first_name %> <%= student.last_name %>
                </p>
                <p class="success-meta">
                    Your account is now awaiting administrator approval.
                </p>

                <div class="success-actions">
                    <a href="/auth/login" class="btn btn-primary">
                        Go to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
<script src="/js/theme.js"></script>
</body>
</html>
