<%- include('../partials/student-header') %>
<div class="student-layout">
    <%- include('../partials/student-sidebar') %>
    <main class="content">
        <%- include('../partials/student-navbar') %>

        <div class="welcome-card">
            <h2><i class="bi bi-images"></i> Club Gallery</h2>
            <p>Browse photos and snapshots from school club activities and events.</p>
        </div>

        <% if (typeof success_msg !== 'undefined' && success_msg) { %>
            <div class="alert alert-success"><%= success_msg %></div>
        <% } %>
        <% if (typeof error_msg !== 'undefined' && error_msg) { %>
            <div class="alert alert-danger"><%= error_msg %></div>
        <% } %>

        <% if (images && images.length > 0) { %>
            <div class="row g-4">
                <% images.forEach(img => { %>
                    <div class="col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm">
                            <a href="/student/gallery/view/<%= img.image_id %>" style="text-decoration: none; color: inherit;">
                                <div style="height: 180px; background: #e2e8f0; overflow: hidden;">
                                    <% if (img.file_path) { %>
                                        <img src="<%= img.file_path %>" alt="<%= img.title %>" style="width: 100%; height: 100%; object-fit: cover;">
                                    <% } else { %>
                                        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #94a3b8;">
                                            <i class="bi bi-image" style="font-size: 3rem;"></i>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="card-body">
                                    <span class="badge bg-primary mb-2"><%= img.club_name || 'General' %></span>
                                    <h6 class="card-title mb-1"><%= img.title %></h6>
                                    <% if (img.caption) { %>
                                        <p class="card-text text-muted small mb-0"><%= img.caption %></p>
                                    <% } %>
                                    <small class="text-muted">
                                        <i class="bi bi-calendar3"></i> <%= new Date(img.uploaded_at).toLocaleDateString() %>
                                    </small>
                                </div>
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="section text-center">
                <i class="bi bi-images" style="font-size: 70px; color: #94a3b8;"></i>
                <h3 class="mt-3">No Gallery Items</h3>
                <p class="text-muted">There are no published gallery items yet.</p>
            </div>
        <% } %>
    </main>
</div>
<%- include('../partials/student-footer') %>