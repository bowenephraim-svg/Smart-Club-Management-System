<%- include('../partials/student-header') %>
<div class="student-layout">
    <%- include('../partials/student-sidebar') %>
    <main class="content">
        <%- include('../partials/student-navbar') %>

        <div class="welcome-card">
            <h2><i class="bi bi-trophy"></i> My Achievements</h2>
            <p>View your academic, sports and club achievements.</p>
        </div>

        <% if (typeof success_msg !== 'undefined' && success_msg) { %>
            <div class="alert alert-success"><%= success_msg %></div>
        <% } %>
        <% if (typeof error_msg !== 'undefined' && error_msg) { %>
            <div class="alert alert-danger"><%= error_msg %></div>
        <% } %>

        <% if (achievements && achievements.length > 0) { %>
            <div class="row g-4">
                <% achievements.forEach(ach => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <a href="/student/achievements/view/<%= ach.achievement_id %>" style="text-decoration: none; color: inherit;">
                                <% if (ach.image) { %>
                                    <div style="height: 160px; background: #e2e8f0; overflow: hidden;">
                                        <img src="<%= ach.image %>" alt="<%= ach.title %>" style="width: 100%; height: 100%; object-fit: cover;">
                                    </div>
                                <% } else { %>
                                    <div style="height: 160px; background: linear-gradient(135deg, #fbbf24, #f59e0b); display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-trophy-fill" style="font-size: 3rem; color: #fff;"></i>
                                    </div>
                                <% } %>
                                <div class="card-body">
                                    <span class="badge bg-warning text-dark mb-2"><%= ach.category || 'Achievement' %></span>
                                    <h6 class="card-title mb-1"><%= ach.title %></h6>
                                    <% if (ach.club_name) { %>
                                        <p class="card-text text-muted small mb-1"><i class="bi bi-people"></i> <%= ach.club_name %></p>
                                    <% } %>
                                    <% if (ach.achievement_date) { %>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar3"></i> <%= new Date(ach.achievement_date).toLocaleDateString() %>
                                        </small>
                                    <% } %>
                                </div>
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="section text-center">
                <i class="bi bi-trophy" style="font-size: 70px; color: #94a3b8;"></i>
                <h3 class="mt-3">No Achievements Yet</h3>
                <p class="text-muted">You have no published achievements at the moment.</p>
            </div>
        <% } %>
    </main>
</div>
<%- include('../partials/student-footer') %>