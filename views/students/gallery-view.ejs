<%- include('../partials/student-header') %>
<div class="student-layout">
    <%- include('../partials/student-sidebar') %>
    <main class="content">
        <%- include('../partials/student-navbar') %>

        <div class="welcome-card">
            <h2><i class="bi bi-image"></i> <%= image.title %></h2>
            <p>Gallery item details.</p>
        </div>

        <div class="section">
            <a href="/student/gallery" class="btn btn-outline-primary mb-3">
                <i class="bi bi-arrow-left"></i> Back to Gallery
            </a>

            <div class="card shadow-sm">
                <% if (image.file_path) { %>
                    <img src="<%= image.file_path %>" alt="<%= image.title %>" class="card-img-top" style="max-height: 500px; object-fit: cover;">
                <% } else { %>
                    <div style="padding: 80px; text-align: center; background: #f1f5f9; color: #94a3b8;">
                        <i class="bi bi-image" style="font-size: 4rem;"></i>
                        <p class="mt-3">No image available.</p>
                    </div>
                <% } %>
                <div class="card-body">
                    <div class="mb-3">
                        <% if (image.club_name) { %>
                            <span class="badge bg-primary me-2"><i class="bi bi-people"></i> <%= image.club_name %></span>
                        <% } %>
                        <% if (image.album_title) { %>
                            <span class="badge bg-secondary me-2"><i class="bi bi-folder"></i> <%= image.album_title %></span>
                        <% } %>
                        <span class="badge bg-light text-dark">
                            <i class="bi bi-calendar3"></i> <%= new Date(image.uploaded_at).toLocaleDateString() %>
                        </span>
                    </div>
                    <% if (image.caption) { %>
                        <h5 class="card-title">Description</h5>
                        <p class="card-text text-muted"><%= image.caption %></p>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</div>
<%- include('../partials/student-footer') %>