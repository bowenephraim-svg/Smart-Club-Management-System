<!DOCTYPE html>
<html lang="en">

<head>

    <link rel="icon" type="image/svg+xml" href="<%= schoolSettings && schoolSettings.school_logo ? schoolSettings.school_logo : '/images/favicon.svg' %>">

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Student Dashboard |
        <%= schoolSettings
            ? (schoolSettings.school_name || 'Smart Club System')
            : 'Smart Club System'
        %>
    </title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- STUDENT CSS -->
    <link rel="stylesheet" href="/css/student.css">

    <!-- Central Design System -->
    <link rel="stylesheet" href="/css/design-system.css">

</head>


<body>

<div class="student-layout">


    <!-- =====================================================
         STUDENT SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <!-- Logo -->

        <div class="logo">

            <h4>
                <%= schoolSettings
                    ? (schoolSettings.school_name || 'Smart Club System')
                    : 'Smart Club System'
                %>
            </h4>

            <small>
                Student Portal
            </small>

        </div>


        <!-- Navigation -->

        <ul>


            <!-- Dashboard -->

            <li class="active">

                <a href="/student/dashboard">

                    <i class="bi bi-speedometer2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>

            </li>



            <!-- =================================================
                 MY CLUBS
            ================================================== -->

            <li>

                <a href="/student/clubs">

                    <i class="bi bi-people"></i>

                    <span>
                        My Clubs
                    </span>

                </a>

            </li>



            <!-- =================================================
                 JOIN A CLUB
            ================================================== -->

            <li>

                <a href="/student/clubs/available">

                    <i class="bi bi-plus-circle"></i>

                    <span>
                        Join a Club
                    </span>

                </a>

            </li>



            <!-- =================================================
                 PAYMENTS
            ================================================== -->

            <li>

                <a href="/student/payments">

                    <i class="bi bi-cash-stack"></i>

                    <span>
                        My Payments
                    </span>

                </a>

            </li>



            <!-- =================================================
                 EVENTS
            ================================================== -->

            <li>

                <a href="/student/events">

                    <i class="bi bi-calendar-event"></i>

                    <span>
                        Events
                    </span>

                </a>

            </li>



            <!-- =================================================
                 ATTENDANCE
            ================================================== -->

            <li>

                <a href="/student/attendance">

                    <i class="bi bi-check2-square"></i>

                    <span>
                        Attendance
                    </span>

                </a>

            </li>



            <!-- =================================================
                 NOTIFICATIONS
            ================================================== -->

            <li>

                <a href="/student/notifications">

                    <i class="bi bi-bell"></i>

                    <span>
                        Notifications
                    </span>

                </a>

            </li>



            <!-- =================================================
                 ELECTIONS
            ================================================== -->

            <li>

                <a href="/elections/available">

                    <i class="bi bi-check2-square"></i>

                    <span>
                        Elections
                    </span>

                </a>

            </li>



            <!-- =================================================
                 PROFILE
            ================================================== -->

            <li>

                <a href="/student/profile">

                    <i class="bi bi-person-circle"></i>

                    <span>
                        My Profile
                    </span>

                </a>

            </li>



            <!-- =================================================
                 LOGOUT
            ================================================== -->

            <li>

                <a href="/auth/logout">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </li>


        </ul>

    </aside>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="content">


        <!-- =================================================
             TOPBAR
        ================================================== -->

        <div class="topbar">

            <div>

                <h3>
                    Student Dashboard
                </h3>

                <small>
                    Welcome back,
                    <%= student.full_name %>
                    👋
                </small>

            </div>


            <div class="profile">

                <a href="/student/profile" title="My Profile">

                    <% if (student && student.profile_image) { %>

                        <img
                            src="<%= student.profile_image %>"
                            alt="Student Profile"
                            class="profile-img"
                        >

                    <% } else { %>

                        <div class="profile-avatar-fallback">
                            <%= student && student.first_name
                                ? student.first_name.charAt(0).toUpperCase()
                                : 'S' %>
                        </div>

                    <% } %>

                </a>

            </div>

        </div>


        <!-- =================================================
             STATISTICS
        ================================================== -->

        <div class="cards">


            <!-- My Clubs -->

            <div class="card-box">

                <i class="bi bi-people-fill"></i>

                <h2>
                    <%= totalClubs %>
                </h2>

                <p>
                    My Clubs
                </p>

            </div>



            <!-- Upcoming Events -->

            <div class="card-box">

                <i class="bi bi-calendar-event"></i>

                <h2>
                    <%= upcomingEvents %>
                </h2>

                <p>
                    Upcoming Events
                </p>

            </div>



            <!-- Attendance -->

            <div class="card-box">

                <i class="bi bi-check-circle-fill"></i>

                <h2>
                    <%= attendanceRate %>%
                </h2>

                <p>
                    Attendance
                </p>

            </div>



            <!-- Notifications -->

            <div class="card-box">

                <i class="bi bi-bell-fill"></i>

                <h2>
                    <%= notifications %>
                </h2>

                <p>
                    Notifications
                </p>

            </div>


        </div>


        <!-- =================================================
             QUICK ACTIONS
        ================================================== -->

        <div class="quick-actions">


            <a
                href="/student/clubs/available"
                class="quick-action join-club-action"
            >

                <div class="quick-action-icon">

                    <i class="bi bi-plus-circle-fill"></i>

                </div>

                <div>

                    <h5>
                        Join a Club
                    </h5>

                    <p>
                        Browse available clubs and submit a membership request.
                    </p>

                </div>

                <i class="bi bi-arrow-right"></i>

            </a>


            <a
                href="/student/clubs"
                class="quick-action"
            >

                <div class="quick-action-icon">

                    <i class="bi bi-people-fill"></i>

                </div>

                <div>

                    <h5>
                        My Clubs
                    </h5>

                    <p>
                        View your current club memberships and requests.
                    </p>

                </div>

                <i class="bi bi-arrow-right"></i>

            </a>


            <a
                href="/student/payments"
                class="quick-action"
            >

                <div class="quick-action-icon">

                    <i class="bi bi-wallet2"></i>

                </div>

                <div>

                    <h5>
                        My Payments
                    </h5>

                    <p>
                        View your registration and other payment records.
                    </p>

                </div>

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <!-- =================================================
             CLUB MEMBERSHIP INFORMATION
        ================================================== -->

        <div class="section membership-info">

            <div class="section-heading">

                <div>

                    <h4>

                        <i class="bi bi-people-fill section-heading-icon"></i>

                        Club Membership

                    </h4>

                    <p>
                        Interested in joining a club?
                        Browse the available clubs and submit your request.
                    </p>

                </div>


                <a
                    href="/student/clubs/available"
                    class="btn btn-primary"
                >

                    <i class="bi bi-plus-circle"></i>

                    Join a Club

                </a>

            </div>

        </div>


        <!-- =================================================
             UPCOMING ACTIVITIES
        ================================================== -->

        <div class="section">


            <h4>

                <i class="bi bi-calendar-event section-heading-icon"></i>

                Upcoming Activities

            </h4>



            <div class="table-responsive">


                <table class="table">


                    <thead>

                        <tr>

                            <th>
                                Activity
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Venue
                            </th>

                        </tr>

                    </thead>



                    <tbody>


                        <% if (
                            activities &&
                            activities.length > 0
                        ) { %>


                            <% activities.forEach(activity => { %>


                                <tr>

                                    <td>

                                        <strong>
                                            <%= activity.title %>
                                        </strong>

                                    </td>


                                    <td>

                                        <%= activity.activity_date %>

                                    </td>


                                    <td>

                                        <%= activity.venue || '-' %>

                                    </td>

                                </tr>


                            <% }) %>


                        <% } else { %>


                            <tr>

                                <td
                                    colspan="3"
                                    class="table-empty-state"
                                >

                                    <i
                                        class="bi bi-calendar-x table-empty-icon"
                                    ></i>

                                    <p class="table-empty-text">
                                        No upcoming activities.
                                    </p>

                                </td>

                            </tr>


                        <% } %>


                    </tbody>


                </table>

            </div>


        </div>


    </main>

</div>



<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
></script>


<script src="/js/theme.js"></script>
</body>

</html>
