<!DOCTYPE html>
<html lang="en">

<head>

    <link rel="icon" type="image/svg+xml" href="<%= schoolSettings && schoolSettings.school_logo ? schoolSettings.school_logo : '/images/favicon.svg' %>">

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        My Payments |
        <%= schoolSettings
            ? (schoolSettings.school_name || 'Smart Club System')
            : 'Smart Club System' %>
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/student.css"
    >

</head>

<body>

<div class="student-layout">

    <!-- =====================================================
         STUDENT SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <div class="logo">

            <h4>
                <%= schoolSettings
                    ? (schoolSettings.school_name || 'Smart Club System')
                    : 'Smart Club System' %>
            </h4>

            <small>Student Portal</small>

        </div>


        <ul>

            <li>
                <a href="/student/dashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
            </li>


            <li>
                <a href="/student/clubs">
                    <i class="bi bi-people"></i>
                    <span>My Clubs</span>
                </a>
            </li>


            <li class="active">
                <a href="/student/payments">
                    <i class="bi bi-cash-stack"></i>
                    <span>My Payments</span>
                </a>
            </li>


            <li>
                <a href="/student/events">
                    <i class="bi bi-calendar-event"></i>
                    <span>Events</span>
                </a>
            </li>


            <li>
                <a href="/student/attendance">
                    <i class="bi bi-check2-square"></i>
                    <span>Attendance</span>
                </a>
            </li>


            <li>
                <a href="/student/notifications">
                    <i class="bi bi-bell"></i>
                    <span>Notifications</span>
                </a>
            </li>


            <li>
                <a href="/elections/available">
                    <i class="bi bi-check2-square"></i>
                    <span>Elections</span>
                </a>
            </li>


            <li>
                <a href="/student/profile">
                    <i class="bi bi-person-circle"></i>
                    <span>My Profile</span>
                </a>
            </li>


            <li>
                <a href="/auth/logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </li>

        </ul>

    </aside>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="content">

        <!-- Topbar -->

        <div class="topbar">

            <div>

                <h3>My Payments</h3>

                <small>
                    View your registration payment history and status.
                </small>

            </div>


            <div class="profile">

                <img
                    src="<%= (typeof student !== 'undefined' && student && student.profile_image) || (typeof user !== 'undefined' && user && user.profile_image) || '/images/default-avatar.png' %>"
                    alt="Student Profile"
                >

            </div>

        </div>


        <!-- =================================================
             STUDENT PAYMENT SUMMARY
        ================================================== -->

        <div class="cards">

            <div class="card-box">

                <i class="bi bi-wallet2"></i>

                <h2>
                    KES <%= totals.totalPaid || 0 %>
                </h2>

                <p>Total Paid</p>

            </div>


            <div class="card-box">

                <i class="bi bi-receipt"></i>

                <h2>
                    <%= payments.length %>
                </h2>

                <p>Total Transactions</p>

            </div>


            <div class="card-box">

                <i class="bi bi-check-circle-fill"></i>

                <h2>
                    <%= totals.paidCount || 0 %>
                </h2>

                <p>Successful Payments</p>

            </div>


            <div class="card-box">

                <i class="bi bi-hourglass-split"></i>

                <h2>
                    <%= totals.pendingCount || 0 %>
                </h2>

                <p>Pending Payments</p>

            </div>

        </div>


        <!-- =================================================
             PAYMENT HISTORY
        ================================================== -->

        <div class="section">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>

                    <h4 class="mb-1">
                        Payment History
                    </h4>

                    <small class="text-muted">
                        Your submitted payment transactions.
                    </small>

                </div>

            </div>


            <% if (payments.length === 0) { %>

                <div class="text-center py-5">

                    <i
                        class="bi bi-receipt"
                        style="font-size:60px;color:#94a3b8;"
                    ></i>

                    <h4 class="mt-3">
                        No Payments Yet
                    </h4>

                    <p class="text-muted">
                        You haven't submitted any payments.
                    </p>

                </div>

            <% } else { %>


                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>

                                <th>#</th>

                                <th>Amount</th>

                                <th>Payment Type</th>

                                <th>Method</th>

                                <th>Transaction Code</th>

                                <th>Date</th>

                                <th>Status</th>

                            </tr>

                        </thead>


                        <tbody>

                        <% payments.forEach((payment, index) => { %>

                            <tr>

                                <td>
                                    <%= index + 1 %>
                                </td>


                                <td>

                                    <strong>
                                        KES <%= payment.amount %>
                                    </strong>

                                </td>


                                <td>
                                    <%= payment.payment_type || 'Registration' %>
                                </td>


                                <td>
                                    <%= payment.payment_method || '-' %>
                                </td>


                                <td>

                                    <code>
                                        <%= payment.transaction_code || '-' %>
                                    </code>

                                </td>


                                <td>

                                    <%= payment.payment_date
                                        ? new Date(payment.payment_date)
                                            .toLocaleDateString()
                                        : '-' %>

                                </td>


                                <td>

                                    <% if (payment.status === 'Paid') { %>

                                        <span class="badge bg-success">
                                            Paid
                                        </span>

                                    <% } else if (payment.status === 'Pending') { %>

                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>

                                    <% } else if (payment.status === 'Rejected') { %>

                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-secondary">
                                            <%= payment.status || 'Unknown' %>
                                        </span>

                                    <% } %>

                                </td>

                            </tr>

                        <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </main>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js">
</script>

<script src="/js/theme.js"></script>
</body>

</html>
