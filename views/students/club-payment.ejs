<!DOCTYPE html>
<html lang="en">

<head>

    <link rel="icon" type="image/svg+xml" href="<%= schoolSettings && schoolSettings.school_logo ? schoolSettings.school_logo : '/images/favicon.svg' %>">

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Club Membership Payment |
        <%= schoolSettings
            ? (schoolSettings.school_name || 'Smart Club System')
            : 'Smart Club System'
        %>
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/student.css"
    >

</head>


<body>

<div class="student-layout">


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <div class="logo">

            <h4>

                <%= schoolSettings
                    ? (schoolSettings.school_name || 'Smart Club System')
                    : 'Smart Club System'
                %>

            </h4>

            <small>
                Student Portal
            </small>

        </div>


        <ul>

            <li>

                <a href="/student/dashboard">

                    <i class="bi bi-speedometer2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/clubs">

                    <i class="bi bi-people"></i>

                    <span>
                        My Clubs
                    </span>

                </a>

            </li>


            <li class="active">

                <a href="/student/clubs/available">

                    <i class="bi bi-plus-circle"></i>

                    <span>
                        Join a Club
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/payments">

                    <i class="bi bi-cash-stack"></i>

                    <span>
                        My Payments
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/events">

                    <i class="bi bi-calendar-event"></i>

                    <span>
                        Events
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/attendance">

                    <i class="bi bi-check2-square"></i>

                    <span>
                        Attendance
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/notifications">

                    <i class="bi bi-bell"></i>

                    <span>
                        Notifications
                    </span>

                </a>

            </li>


            <li>

                <a href="/elections/available">

                    <i class="bi bi-check2-square"></i>

                    <span>
                        Elections
                    </span>

                </a>

            </li>


            <li>

                <a href="/student/profile">

                    <i class="bi bi-person-circle"></i>

                    <span>
                        My Profile
                    </span>

                </a>

            </li>


            <li>

                <a href="/auth/logout">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </li>

        </ul>

    </aside>



    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="content">

        <% if (typeof error_msg !== 'undefined' && error_msg) { %>
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <%= error_msg %>
            </div>
        <% } %>

        <% if (typeof success_msg !== 'undefined' && success_msg) { %>
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <%= success_msg %>
            </div>
        <% } %>


        <!-- TOPBAR -->

        <div class="topbar">

            <div>

                <h3>
                    Club Membership
                </h3>

                <small>
                    Complete your membership payment.
                </small>

            </div>


            <div class="profile">

                <img
                    src="<%= (typeof student !== 'undefined' && student && student.profile_image) || (typeof user !== 'undefined' && user && user.profile_image) || '/images/default-avatar.png' %>"
                    alt="Student Profile"
                >

            </div>

        </div>



        <!-- BACK BUTTON -->

        <div class="mb-4">

            <a
                href="/student/clubs/available"
                class="btn btn-outline-secondary"
            >

                <i class="bi bi-arrow-left me-1"></i>

                Back to Clubs

            </a>

        </div>



        <!-- =================================================
             PAYMENT CARD
        ================================================== -->

        <div
            class="card shadow-sm border-0"
            style="max-width:700px;margin:0 auto;"
        >

            <div class="card-body p-4 p-md-5">


                <!-- Header -->

                <div class="text-center mb-4">

                    <div
                        style="
                            width:75px;
                            height:75px;
                            margin:0 auto 15px;
                            border-radius:20px;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            background:#eef2ff;
                            color:#4f46e5;
                            font-size:35px;
                        "
                    >

                        <i class="bi bi-people-fill"></i>

                    </div>


                    <h2>

                        Join
                        <%= club.club_name %>

                    </h2>


                    <p class="text-muted">

                        Club membership payment

                    </p>

                </div>



                <!-- =================================================
                     CLUB INFORMATION
                ================================================== -->

                <div
                    class="alert alert-light border mb-4"
                >

                    <div class="row">


                        <div class="col-md-6 mb-3 mb-md-0">

                            <small class="text-muted">
                                Club
                            </small>

                            <div class="fw-bold">

                                <%= club.club_name %>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Student
                            </small>

                            <div class="fw-bold">

                                <%= student.first_name %>
                                <%= student.last_name %>

                            </div>

                        </div>


                    </div>

                </div>



                <!-- =================================================
                     FEE
                ================================================== -->

                <div
                    class="text-center p-4 mb-4"
                    style="
                        background:#f8fafc;
                        border-radius:15px;
                    "
                >

                    <small class="text-muted">

                        Membership Fee

                    </small>


                    <h1 class="mt-2 mb-0">

                        KES
                        <%= Number(
                            club.membership_fee || 0
                        ).toLocaleString() %>

                    </h1>

                </div>



                <% if (
                    Number(club.membership_fee || 0) <= 0
                ) { %>


                    <!-- FREE CLUB -->

                    <div class="alert alert-success">

                        <i class="bi bi-check-circle-fill me-2"></i>

                        This club is free to join.

                    </div>


                    <form
                        method="POST"
                        action="/student/clubs/<%= club.club_id %>/payment"
                    >

                        <input
                            type="hidden"
                            name="payment_method"
                            value="Free"
                        >


                        <input
                            type="hidden"
                            name="transaction_code"
                            value="FREE"
                        >


                        <button
                            type="submit"
                            class="btn btn-success w-100 py-3"
                        >

                            <i class="bi bi-person-plus me-2"></i>

                            Submit Membership Request

                        </button>

                    </form>

                    <button
                        type="button"
                        class="btn btn-outline-primary w-100 py-3 mt-3"
                        data-prompt-phone="<%= student.phone || '' %>"
                        data-prompt-message="Hello <%= student.first_name %>, please complete your membership request for <%= club.club_name %>."
                        onclick="sendStudentPhonePrompt(this)"
                    >
                        <i class="bi bi-chat-dots me-2"></i>
                        Send Prompt to My Phone
                    </button>


                <% } else { %>


                    <!-- =================================================
                         PAYMENT FORM
                    ================================================== -->

                    <form
                        method="POST"
                        action="/student/clubs/<%= club.club_id %>/payment"
                    >


                        <!-- Payment Method -->

                        <div class="mb-4">

                            <label
                                for="payment_method"
                                class="form-label fw-semibold"
                            >

                                Payment Method

                            </label>


                            <select
                                name="payment_method"
                                id="payment_method"
                                class="form-select"
                                required
                            >

                                <option value="">
                                    Select payment method
                                </option>

                                <option value="M-Pesa">
                                    M-Pesa
                                </option>

                                <option value="Bank">
                                    Bank
                                </option>

                                <option value="Cash">
                                    Cash
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                        </div>



                        <!-- Transaction Code -->

                        <div class="mb-4">

                            <label
                                for="transaction_code"
                                class="form-label fw-semibold"
                            >

                                Transaction Code

                            </label>


                            <input
                                type="text"
                                name="transaction_code"
                                id="transaction_code"
                                class="form-control"
                                placeholder="e.g. QGH7XYZ123"
                                maxlength="100"
                                required
                            >


                            <div class="form-text">

                                Enter the transaction/reference number
                                for your payment.

                            </div>

                        </div>



                        <!-- Notice -->

                        <div class="alert alert-info">

                            <i class="bi bi-info-circle-fill me-2"></i>

                            Your payment will be submitted for
                            administrator verification. Your club
                            membership will remain pending until the
                            request is approved.

                        </div>



                        <!-- Submit -->

                        <button
                            type="submit"
                            class="btn btn-primary w-100 py-3"
                        >

                            <i class="bi bi-credit-card me-2"></i>

                            Submit Payment & Join Club

                        </button>


                    </form>

                    <button
                        type="button"
                        class="btn btn-outline-primary w-100 py-3 mt-3"
                        data-prompt-phone="<%= student.phone || '' %>"
                        data-prompt-message="Hello <%= student.first_name %>, please complete your membership payment for <%= club.club_name %>."
                        onclick="sendStudentPhonePrompt(this)"
                    >
                        <i class="bi bi-chat-dots me-2"></i>
                        Send Prompt to My Phone
                    </button>


                <% } %>


            </div>

        </div>


    </main>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
></script>


<script src="/js/theme.js"></script>
<script>
function sendStudentPhonePrompt(button) {
    const phone = (button.dataset.promptPhone || '').trim();
    const message = button.dataset.promptMessage || '';

    if (!phone) {
        window.alert('No phone number is saved for your student profile. Update your profile first.');
        return;
    }

    const normalizedPhone = phone.replace(/[^+\d]/g, '');
    if (normalizedPhone.length < 7) {
        window.alert('The saved phone number is not valid. Update your profile first.');
        return;
    }

    button.disabled = true;
    button.innerHTML = '<i class="bi bi-chat-dots me-2"></i> Opening messages...';
    window.location.href = `sms:${normalizedPhone}?body=${encodeURIComponent(message)}`;

    window.setTimeout(() => {
        button.disabled = false;
        button.innerHTML = '<i class="bi bi-chat-dots me-2"></i> Send Prompt to My Phone';
    }, 2500);
}
</script>
</body>

</html>
