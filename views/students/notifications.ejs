<!DOCTYPE html>
<html lang="en">

<head>

    <link rel="icon" type="image/svg+xml" href="<%= schoolSettings && schoolSettings.school_logo ? schoolSettings.school_logo : '/images/favicon.svg' %>">

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        Notifications |
        <%= schoolSettings
            ? (schoolSettings.school_name || 'Smart Club System')
            : 'Smart Club System' %>
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/student.css">

</head>

<body>

<div class="student-layout">

    <!-- STUDENT SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <h4>
                <%= schoolSettings
                    ? (schoolSettings.school_name || 'Smart Club System')
                    : 'Smart Club System' %>
            </h4>

            <small>Student Portal</small>

        </div>

        <ul>

            <li>
                <a href="/student/dashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <li>
                <a href="/student/clubs">
                    <i class="bi bi-people"></i>
                    <span>My Clubs</span>
                </a>
            </li>

            <li>
                <a href="/student/payments">
                    <i class="bi bi-cash-stack"></i>
                    <span>My Payments</span>
                </a>
            </li>

            <li>
                <a href="/student/events">
                    <i class="bi bi-calendar-event"></i>
                    <span>Events</span>
                </a>
            </li>

            <li>
                <a href="/student/attendance">
                    <i class="bi bi-check2-square"></i>
                    <span>Attendance</span>
                </a>
            </li>

            <li class="active">
                <a href="/student/notifications">
                    <i class="bi bi-bell"></i>
                    <span>Notifications</span>
                </a>
            </li>

            <li>
                <a href="/elections/available">
                    <i class="bi bi-check2-square"></i>
                    <span>Elections</span>
                </a>
            </li>

            <li>
                <a href="/student/profile">
                    <i class="bi bi-person-circle"></i>
                    <span>My Profile</span>
                </a>
            </li>

            <li>
                <a href="/auth/logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </li>

        </ul>

    </aside>


    <!-- MAIN CONTENT -->

    <main class="content">

        <div class="topbar">

            <div>

                <h3>Notifications</h3>

                <small>
                    Stay updated with your club activities.
                </small>

            </div>

            <div class="profile">

                <img
                    src="<%= (typeof student !== 'undefined' && student && student.profile_image) || (typeof user !== 'undefined' && user && user.profile_image) || '/images/default-avatar.png' %>"
                    alt="Student Profile">

            </div>

        </div>


        <% if (!notifications || notifications.length === 0) { %>

            <div class="empty-state">

                <i class="bi bi-bell"></i>

                <h3>
                    No Notifications
                </h3>

                <p>
                    You're all caught up.
                </p>

            </div>

        <% } else { %>


            <% notifications.forEach(notification => { %>

                <div class="notification-card
                    <%= notification.status === 'Unread' ? 'unread' : '' %>">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h5>

                                <% if (notification.type === 'Payment') { %>

                                    <i class="bi bi-cash-coin text-success"></i>

                                <% } else if (notification.type === 'Membership') { %>

                                    <i class="bi bi-people-fill text-primary"></i>

                                <% } else { %>

                                    <i class="bi bi-bell-fill text-warning"></i>

                                <% } %>

                                <%= notification.type %>

                            </h5>

                            <p>
                                <%= notification.message %>
                            </p>

                            <small>
                                <%= new Date(
                                    notification.created_at
                                ).toLocaleString() %>
                            </small>

                        </div>


                        <div class="text-end">

                            <% if (notification.status === 'Unread') { %>

                                <span class="badge bg-danger">
                                    Unread
                                </span>

                                <br><br>

                                <a
                                    href="/student/notifications/read/<%= notification.notification_id %>"
                                    class="btn btn-success btn-sm">

                                    <i class="bi bi-check2"></i>
                                    Mark Read

                                </a>

                            <% } else { %>

                                <span class="badge bg-success">
                                    Read
                                </span>

                            <% } %>

                        </div>

                    </div>

                </div>

            <% }) %>


            <div class="mt-3">

                <a
                    href="/student/notifications/read-all"
                    class="btn btn-primary">

                    <i class="bi bi-check2-all"></i>

                    Mark All Read

                </a>

            </div>

        <% } %>

    </main>

</div>

<script src="/js/theme.js"></script>
</body>
</html>
