<!DOCTYPE html>
<html lang="en">

<head>

    <link rel="icon" type="image/svg+xml" href="<%= schoolSettings && schoolSettings.school_logo ? schoolSettings.school_logo : '/images/favicon.svg' %>">

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        My Clubs |
        <%= schoolSettings
            ? (schoolSettings.school_name || 'Smart Club System')
            : 'Smart Club System'
        %>
    </title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- Bootstrap Icons -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
        rel="stylesheet"
    >


    <!-- Student CSS -->

    <link
        rel="stylesheet"
        href="/css/student.css"
    >

</head>


<body>


<div class="student-layout">


    <!-- =====================================================
         STUDENT SIDEBAR
    ====================================================== -->

    <aside class="sidebar">


        <!-- Logo -->

        <div class="logo">

            <h4>

                <%= schoolSettings
                    ? (schoolSettings.school_name || 'Smart Club System')
                    : 'Smart Club System'
                %>

            </h4>

            <small>
                Student Portal
            </small>

        </div>


        <!-- Navigation -->

        <ul>


            <!-- Dashboard -->

            <li>

                <a href="/student/dashboard">

                    <i class="bi bi-speedometer2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>

            </li>


            <!-- My Clubs -->

            <li class="active">

                <a href="/student/clubs">

                    <i class="bi bi-people"></i>

                    <span>
                        My Clubs
                    </span>

                </a>

            </li>

            <li>
                <a href="/student/clubs/available">
                <i class="bi bi-plus-circle"></i>
                  <span>Join a Club</span>
            </a>
               </li>


            <!-- Payments -->

            <li>

                <a href="/student/payments">

                    <i class="bi bi-cash-stack"></i>

                    <span>
                        My Payments
                    </span>

                </a>

            </li>


            <!-- Events -->

            <li>

                <a href="/student/events">

                    <i class="bi bi-calendar-event"></i>

                    <span>
                        Events
                    </span>

                </a>

            </li>


            <!-- Attendance -->

            <li>

                <a href="/student/attendance">

                    <i class="bi bi-check2-square"></i>

                    <span>
                        Attendance
                    </span>

                </a>

            </li>


            <!-- Notifications -->

            <li>

                <a href="/student/notifications">

                    <i class="bi bi-bell"></i>

                    <span>
                        Notifications
                    </span>

                </a>

            </li>


            <!-- Elections -->

            <li>

                <a href="/elections/available">

                    <i class="bi bi-check2-square"></i>

                    <span>
                        Elections
                    </span>

                </a>

            </li>


            <!-- Profile -->

            <li>

                <a href="/student/profile">

                    <i class="bi bi-person-circle"></i>

                    <span>
                        My Profile
                    </span>

                </a>

            </li>


            <!-- Logout -->

            <li>

                <a href="/auth/logout">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </li>


        </ul>

    </aside>



    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="content">


        <!-- =================================================
             TOPBAR
        ================================================== -->

        <div class="topbar">


            <div>

                <h3>
                    My Clubs
                </h3>

                <small>
                    View your club memberships and their status.
                </small>

            </div>


            <div class="profile">

                <img
                    src="<%= (typeof student !== 'undefined' && student && student.profile_image) || (typeof user !== 'undefined' && user && user.profile_image) || '/images/default-avatar.png' %>"
                    alt="Student Profile"
                >

            </div>


        </div>



        <!-- =================================================
             WELCOME CARD
        ================================================== -->

        <div class="welcome-card">

            <h2>
                My Club Memberships
            </h2>

            <p>
                Keep track of the clubs you belong to and the status
                of your membership requests.
            </p>

        </div>



        <!-- =================================================
             STATISTICS
        ================================================== -->

        <div class="cards">


            <!-- Total -->

            <div class="card-box">

                <i class="bi bi-people-fill"></i>

                <h2>

                    <%= memberships
                        ? memberships.length
                        : 0 %>

                </h2>

                <p>
                    Total Memberships
                </p>

            </div>



            <!-- Active -->

            <div class="card-box">

                <i class="bi bi-check-circle-fill"></i>

                <h2>

                    <%= memberships
                        ? memberships.filter(
                            m => m.status === 'Active'
                        ).length
                        : 0 %>

                </h2>

                <p>
                    Active Clubs
                </p>

            </div>



            <!-- Pending -->

            <div class="card-box">

                <i class="bi bi-hourglass-split"></i>

                <h2>

                    <%= memberships
                        ? memberships.filter(
                            m => m.status === 'Pending'
                        ).length
                        : 0 %>

                </h2>

                <p>
                    Pending Approval
                </p>

            </div>



            <!-- Rejected -->

            <div class="card-box">

                <i class="bi bi-x-circle-fill"></i>

                <h2>

                    <%= memberships
                        ? memberships.filter(
                            m => m.status === 'Rejected'
                        ).length
                        : 0 %>

                </h2>

                <p>
                    Rejected
                </p>

            </div>


        </div>



        <!-- =================================================
             MEMBERSHIP TABLE
        ================================================== -->

        <div class="section">


            <h4>

                <i
                    class="bi bi-people-fill"
                    style="margin-right:8px;"
                ></i>

                My Club Memberships

            </h4>



            <div class="table-responsive">


                <table class="table">


                    <thead>

                        <tr>

                            <th>
                                Club
                            </th>

                            <th>
                                Description
                            </th>

                            <th>
                                Joined
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>



                    <tbody>


                        <% if (
                            !memberships ||
                            memberships.length === 0
                        ) { %>


                            <tr>

                                <td
                                    colspan="4"
                                    style="
                                        text-align:center;
                                        padding:50px 20px;
                                        color:#64748b;
                                    "
                                >

                                    <i
                                        class="bi bi-people"
                                        style="
                                            display:block;
                                            font-size:50px;
                                            margin-bottom:15px;
                                        "
                                    ></i>


                                    <strong
                                        style="
                                            display:block;
                                            margin-bottom:5px;
                                        "
                                    >

                                        You haven't joined any clubs yet.

                                    </strong>


                                    <span>

                                        Your club memberships will appear here.

                                    </span>

                                </td>

                            </tr>


                        <% } else { %>


                            <% memberships.forEach(membership => { %>


                                <tr>


                                    <!-- Club -->

                                    <td>

                                        <strong>
                                            <%= membership.club_name %>
                                        </strong>

                                    </td>


                                    <!-- Description -->

                                    <td>

                                        <%= membership.description || '-' %>

                                    </td>


                                    <!-- Join Date -->

                                    <td>

                                        <%= membership.join_date
                                            ? new Date(
                                                membership.join_date
                                            ).toLocaleDateString()
                                            : '-' %>

                                    </td>


                                    <!-- Status -->

                                    <td>


                                        <% if (
                                            membership.status === 'Active'
                                        ) { %>


                                            <span class="student-status active">

                                                <i class="bi bi-check-circle-fill"></i>

                                                Active

                                            </span>


                                        <% } else if (
                                            membership.status === 'Pending'
                                        ) { %>


                                            <span class="student-status pending">

                                                <i class="bi bi-hourglass-split"></i>

                                                Pending Approval

                                            </span>


                                        <% } else if (
                                            membership.status === 'Rejected'
                                        ) { %>


                                            <span class="student-status rejected">

                                                <i class="bi bi-x-circle-fill"></i>

                                                Rejected

                                            </span>


                                        <% } else { %>


                                            <span class="student-status">

                                                <%= membership.status || 'Unknown' %>

                                            </span>


                                        <% } %>


                                    </td>


                                </tr>


                            <% }) %>


                        <% } %>


                    </tbody>


                </table>


            </div>


        </div>


    </main>


</div>



<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
></script>


<script src="/js/theme.js"></script>
</body>

</html>
