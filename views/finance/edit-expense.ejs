<%- include('../partials/header') %>
<div class="app-layout-container">
    <%- include('../partials/sidebar') %>
    
    <div class="main-content-window">
        <%- include('../partials/navbar') %>
        
        <main class="workspace-viewport">
            <div class="back-navigation-row">
                <a href="/dashboard" class="back-link"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
            </div>

            <div class="page-header">
                <div>
                    <h2>Edit Expense</h2>
                    <p>Update an existing expense record.</p>
                </div>
            </div>

            <div class="card">
    <form action="/finance/expenses/edit/<%= expense.expense_id %>" method="POST" class="standard-system-form">
        <div class="form-grid-two-columns">
            <div class="input-field-wrapper">
                <label for="club_id">Club</label>
                <select id="club_id" name="club_id" required>
                    <option value="" disabled>Select club</option>
                    <% if (clubs && clubs.length > 0) { %>
                        <% clubs.forEach(club => { %>
                            <option value="<%= club.club_id %>" <%= club.club_id === expense.club_id ? 'selected' : '' %>><%= club.club_name %></option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <div class="input-field-wrapper">
                <label for="expense_name">Expense Name</label>
                <input type="text" id="expense_name" name="expense_name" value="<%= expense.expense_name %>" required>
            </div>
        </div>

        <div class="form-grid-two-columns">
            <div class="input-field-wrapper">
                <label for="amount">Amount (KES)</label>
                <input type="number" id="amount" name="amount" step="0.01" value="<%= expense.amount %>" required>
            </div>

            <div class="input-field-wrapper">
                <label for="expense_date">Expense Date</label>
                <input type="date" id="expense_date" name="expense_date" value="<%= expense.expense_date %>" required>
            </div>
        </div>

        <div class="input-field-wrapper">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="3"><%= expense.description || '' %></textarea>
        </div>

        <div class="form-action-footer-row">
            <a href="/finance/expenses" class="btn btn-muted">Cancel</a>
            <button type="submit" class="btn btn-primary">Update Expense</button>
        </div>
    </form>
</div>

        </main>
        
        <%- include('../partials/footer') %>
    </div>
</div>
