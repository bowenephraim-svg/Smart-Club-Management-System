<%- include('partials/header', { pageTitle: '404 Not Found' }) %>

<main class="error-page" role="main">
    <div style="font-size: 120px; color: #2563eb; font-weight: 800; line-height: 1; text-shadow: 4px 4px 0px #e2e8f0; margin-bottom: 10px;">
        404
    </div>
    <h2 style="font-size: 32px; color: var(--text-primary); margin: 10px 0 20px; font-weight: 700;">Page Not Found</h2>
    <p style="color: var(--text-secondary); font-size: 18px; max-width: 500px; margin-bottom: 30px; line-height: 1.6;">
        The page you requested is not available. It may have moved, or the address may be incorrect.
    </p>
    <a href="<%= homeUrl || '/' %>" class="btn btn-primary" style="padding: 12px 30px; font-size: 16px; border-radius: 50px; display: inline-flex; align-items: center; gap: 10px; transition: all 0.3s ease; box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.39);">
        <i class="fas fa-arrow-left"></i> Return to dashboard
    </a>
</main>

<%- include('partials/footer') %>
