<%- include('../partials/header') %>
<div class="app-layout-container">
    <%- include('../partials/sidebar') %>
    
    <div class="main-content-window">
        <%- include('../partials/navbar') %>
        
        <main class="workspace-viewport">
            <div class="back-navigation-row">
                <a href="/dashboard" class="back-link"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
            </div>

            <div class="page-header">
                <div>
                    <h2>Submit Feedback</h2>
                    <p>Share your thoughts, suggestions, or report issues to help us improve the system.</p>
                </div>
            </div>

            <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin-bottom: 20px;">
                    <i class="fas fa-check-circle me-2"></i> <%= success_msg %>
                    <button type="button" class="alert-close-btn" aria-label="Close" onclick="this.parentElement.style.display='none';">&times;</button>
                </div>
            <% } %>

            <div class="form-container-card" style="margin-top: 0;">
                <form action="/feedback/submit" method="POST" class="standard-system-form">
                    <div class="form-grid-two-columns">
                        <div class="input-field-wrapper">
                            <label for="category">Category <span class="required">*</span></label>
                            <select id="category" name="category" required>
                                <option value="" disabled selected>Select feedback type</option>
                                <option value="Bug Report">Bug Report</option>
                                <option value="Feature Request">Feature Request</option>
                                <option value="General Suggestion">General Suggestion</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="input-field-wrapper">
                            <label for="subject">Subject <span class="required">*</span></label>
                            <input type="text" id="subject" name="subject" required placeholder="Brief summary of your feedback">
                        </div>
                    </div>

                    <div class="input-field-wrapper">
                        <label for="message">Your Message <span class="required">*</span></label>
                        <textarea id="message" name="message" rows="5" required placeholder="Please provide detailed feedback here..."></textarea>
                    </div>

                    <div class="form-action-footer-row">
                        <button type="reset" class="btn btn-muted">Clear</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Submit Feedback</button>
                    </div>
                </form>
            </div>
        </main>
        
        <%- include('../partials/footer') %>
    </div>
</div>
