<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/svg+xml" href="<%= schoolSettings && schoolSettings.school_logo ? schoolSettings.school_logo : '/images/favicon.svg' %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= schoolSettings
            ? (schoolSettings.school_name || 'Smart Club System')
            : 'Smart Club System' %>
        | Student Portal
    </title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- STUDENT CSS -->
    <link rel="stylesheet" href="/css/student.css">

    <!-- Central Design System (loaded last so it wins the cascade) -->
    <link rel="stylesheet" href="/css/design-system.css">
    <script src="/js/theme.js"></script>

</head>
<body>
<script>
    // The student portal shares the same saved preference as the admin and
    // patron portals, so it opens in the selected theme without flashing.
    try {
        if (localStorage.getItem('victory-theme') === 'dark') {
            document.body.classList.add('dark-theme');
        }
    } catch (_) {}
</script>

<div class="student-app">
