<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Club Management System</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;500;600;700&family=Exo+2:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            overflow-x: hidden;
            background: #0a0a1a;
            font-family: 'Rajdhani', sans-serif;
            color: #fff;
        }

        #canvas-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        .overlay {
            position: relative;
            z-index: 10;
            pointer-events: none;
        }

        .overlay * {
            pointer-events: auto;
        }

        .header {
            text-align: center;
            padding: 40px 20px 20px;
            position: relative;
        }

        .header h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(1.8rem, 5vw, 3.5rem);
            font-weight: 900;
            background: linear-gradient(135deg, #00f0ff, #7b2ff7, #ff2daa, #00f0ff);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradientShift 4s ease infinite;
            text-shadow: none;
            letter-spacing: 3px;
            margin-bottom: 10px;
        }

        .header .subtitle {
            font-family: 'Exo 2', sans-serif;
            font-size: clamp(0.9rem, 2vw, 1.3rem);
            color: rgba(255,255,255,0.6);
            font-weight: 300;
            letter-spacing: 5px;
            text-transform: uppercase;
        }

        .header .tagline {
            margin-top: 15px;
            font-size: clamp(0.85rem, 1.5vw, 1.1rem);
            color: rgba(255,255,255,0.45);
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
            line-height: 1.6;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .clubs-section {
            padding: 20px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(1.2rem, 3vw, 1.8rem);
            color: #00f0ff;
            margin-bottom: 40px;
            position: relative;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, #00f0ff, #7b2ff7);
            margin: 12px auto 0;
            border-radius: 2px;
        }

        .clubs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            perspective: 1000px;
        }

        .club-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 28px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(10px);
            transform-style: preserve-3d;
            animation: floatCard 6s ease-in-out infinite;
        }

        .club-card:nth-child(1) { animation-delay: 0s; }
        .club-card:nth-child(2) { animation-delay: 0.5s; }
        .club-card:nth-child(3) { animation-delay: 1s; }
        .club-card:nth-child(4) { animation-delay: 1.5s; }
        .club-card:nth-child(5) { animation-delay: 2s; }
        .club-card:nth-child(6) { animation-delay: 2.5s; }
        .club-card:nth-child(7) { animation-delay: 3s; }
        .club-card:nth-child(8) { animation-delay: 3.5s; }
        .club-card:nth-child(9) { animation-delay: 4s; }
        .club-card:nth-child(10) { animation-delay: 4.5s; }

        @keyframes floatCard {
            0%, 100% { transform: translateY(0) rotateX(0) rotateY(0); }
            25% { transform: translateY(-8px) rotateX(2deg) rotateY(-1deg); }
            75% { transform: translateY(-4px) rotateX(-1deg) rotateY(2deg); }
        }

        .club-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, var(--card-color1), var(--card-color2));
            opacity: 0;
            transition: opacity 0.5s;
            border-radius: 16px;
        }

        .club-card:hover::before {
            opacity: 0.12;
        }

        .club-card::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
            opacity: 0;
            transition: opacity 0.5s;
            pointer-events: none;
        }

        .club-card:hover::after {
            opacity: 1;
        }

        .club-card:hover {
            transform: translateY(-15px) scale(1.05) !important;
            border-color: var(--card-color1);
            box-shadow: 0 20px 60px rgba(0,0,0,0.4), 0 0 30px var(--card-shadow);
        }

        .club-icon {
            font-size: 2.8rem;
            margin-bottom: 14px;
            display: block;
            filter: drop-shadow(0 0 10px var(--card-color1));
            transition: transform 0.5s;
        }

        .club-card:hover .club-icon {
            transform: scale(1.2) rotateY(360deg);
        }

        .club-name {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 8px;
            letter-spacing: 1px;
        }

        .club-desc {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.45);
            line-height: 1.4;
        }

        .club-members {
            margin-top: 12px;
            font-size: 0.75rem;
            color: var(--card-color1);
            font-weight: 600;
        }

        .features-section {
            padding: 60px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-top: 40px;
        }

        .feature-card {
            background: linear-gradient(135deg, rgba(123,47,247,0.08), rgba(0,240,255,0.05));
            border: 1px solid rgba(123,47,247,0.2);
            border-radius: 20px;
            padding: 30px;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .feature-card:hover {
            transform: translateY(-8px);
            border-color: rgba(0,240,255,0.5);
            box-shadow: 0 15px 40px rgba(0,0,0,0.3), inset 0 0 30px rgba(0,240,255,0.05);
        }

        .feature-icon {
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .feature-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1rem;
            color: #00f0ff;
            margin-bottom: 10px;
        }

        .feature-desc {
            font-size: 0.85rem;
            color: rgba(255,255,255,0.5);
            line-height: 1.6;
        }

        .floating-actions {
            position: fixed;
            right: 25px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 15px;
            z-index: 100;
        }

        .fab-btn {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            border: 2px solid rgba(255,255,255,0.15);
            background: rgba(10,10,26,0.8);
            backdrop-filter: blur(15px);
            color: #fff;
            font-size: 1.3rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            position: relative;
            overflow: hidden;
            animation: fabPulse 3s ease-in-out infinite;
        }

        .fab-btn:nth-child(1) { animation-delay: 0s; }
        .fab-btn:nth-child(2) { animation-delay: 0.4s; }
        .fab-btn:nth-child(3) { animation-delay: 0.8s; }
        .fab-btn:nth-child(4) { animation-delay: 1.2s; }
        .fab-btn:nth-child(5) { animation-delay: 1.6s; }

        @keyframes fabPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(0,240,255,0); }
            50% { box-shadow: 0 0 20px 2px rgba(0,240,255,0.15); }
        }

        .fab-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--btn-color1, #00f0ff), var(--btn-color2, #7b2ff7));
            opacity: 0;
            transition: opacity 0.4s;
        }

        .fab-btn:hover::before {
            opacity: 1;
        }

        .fab-btn:hover {
            transform: scale(1.2);
            border-color: transparent;
            box-shadow: 0 0 30px rgba(0,240,255,0.4);
        }

        .fab-btn span {
            position: relative;
            z-index: 2;
        }

        .fab-tooltip {
            position: absolute;
            right: 70px;
            background: rgba(10,10,26,0.95);
            border: 1px solid rgba(0,240,255,0.3);
            color: #00f0ff;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 0.75rem;
            font-family: 'Exo 2', sans-serif;
            white-space: nowrap;
            opacity: 0;
            transform: translateX(10px);
            transition: all 0.3s;
            pointer-events: none;
        }

        .fab-btn:hover .fab-tooltip {
            opacity: 1;
            transform: translateX(0);
        }

        .stats-bar {
            display: flex;
            justify-content: center;
            gap: 40px;
            flex-wrap: wrap;
            padding: 30px 20px;
            margin: 20px auto;
            max-width: 900px;
        }

        .stat-item {
            text-align: center;
            animation: fadeInUp 1s ease forwards;
            opacity: 0;
        }

        .stat-item:nth-child(1) { animation-delay: 0.2s; }
        .stat-item:nth-child(2) { animation-delay: 0.4s; }
        .stat-item:nth-child(3) { animation-delay: 0.6s; }
        .stat-item:nth-child(4) { animation-delay: 0.8s; }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .stat-number {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 900;
            background: linear-gradient(135deg, #00f0ff, #7b2ff7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .stat-label {
            font-size: 0.85rem;
            color: rgba(255,255,255,0.4);
            margin-top: 5px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .bottom-cta {
            text-align: center;
            padding: 50px 20px 80px;
        }

        .cta-btn {
            display: inline-block;
            padding: 16px 50px;
            font-family: 'Orbitron', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(135deg, #7b2ff7, #00f0ff);
            border: none;
            border-radius: 50px;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 3px;
            transition: all 0.4s;
            position: relative;
            overflow: hidden;
            text-decoration: none;
        }

        .cta-btn::before {
            content: '';
            position: absolute;
            inset: -2px;
            background: linear-gradient(135deg, #00f0ff, #7b2ff7, #ff2daa, #00f0ff);
            background-size: 300% 300%;
            animation: gradientShift 3s ease infinite;
            border-radius: 50px;
            z-index: -1;
            filter: blur(8px);
            opacity: 0.6;
        }

        .cta-btn:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 40px rgba(123,47,247,0.4);
        }

        .scroll-indicator {
            position: fixed;
            bottom: 25px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 50;
            animation: bounce 2s infinite;
            color: rgba(255,255,255,0.3);
            font-size: 1.5rem;
            cursor: pointer;
            transition: opacity 0.3s;
        }

        .scroll-indicator.hidden {
            opacity: 0;
            pointer-events: none;
        }

        @keyframes bounce {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(-10px); }
        }

        .nav-dots {
            position: fixed;
            left: 25px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 12px;
            z-index: 100;
        }

        .nav-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: 2px solid rgba(255,255,255,0.3);
            background: transparent;
            cursor: pointer;
            transition: all 0.3s;
        }

        .nav-dot.active {
            background: #00f0ff;
            border-color: #00f0ff;
            box-shadow: 0 0 10px rgba(0,240,255,0.5);
        }

        .nav-dot:hover {
            border-color: #00f0ff;
        }

        .particle-info {
            position: fixed;
            bottom: 20px;
            right: 20px;
            font-size: 0.7rem;
            color: rgba(255,255,255,0.2);
            z-index: 100;
            font-family: 'Exo 2', sans-serif;
        }

        @media (max-width: 768px) {
            .floating-actions {
                right: 10px;
                gap: 10px;
            }
            .fab-btn {
                width: 44px;
                height: 44px;
                font-size: 1rem;
            }
            .nav-dots {
                display: none;
            }
            .stats-bar {
                gap: 20px;
            }
            .clubs-grid {
                grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
                gap: 12px;
            }
        }

        .loading-screen {
            position: fixed;
            inset: 0;
            background: #0a0a1a;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            transition: opacity 0.8s, visibility 0.8s;
        }

        .loading-screen.hidden {
            opacity: 0;
            visibility: hidden;
        }

        .loader-ring {
            width: 80px;
            height: 80px;
            border: 3px solid rgba(255,255,255,0.1);
            border-top-color: #00f0ff;
            border-right-color: #7b2ff7;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .loader-text {
            margin-top: 20px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
            color: rgba(255,255,255,0.5);
            letter-spacing: 3px;
        }

        .glow-line {
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0,240,255,0.3), rgba(123,47,247,0.3), transparent);
            margin: 10px 0;
        }
    </style>
</head>
<body>

    <div class="loading-screen" id="loadingScreen">
        <div class="loader-ring"></div>
        <div class="loader-text">INITIALIZING</div>
    </div>

    <div id="canvas-container"></div>

    <div class="overlay">
        <header class="header" id="section-home">
            <h1>SMART CLUB MANAGEMENT</h1>
            <div class="subtitle">Unified School Club Platform</div>
            <div class="tagline">
                Streamline every club's operations — from memberships & events to scheduling & communication — 
                all in one intelligent, intuitive system designed for the modern school campus.
            </div>
        </header>

        <div class="glow-line"></div>

        <div class="stats-bar">
            <div class="stat-item">
                <div class="stat-number" id="stat1">90</div>
                <div class="stat-label">Active Clubs</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" id="stat2">0</div>
                <div class="stat-label">Members</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" id="stat3">0</div>
                <div class="stat-label">Events/Month</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" id="stat4">0</div>
                <div class="stat-label"> satisfaction</div>
            </div>
        </div>

        <div class="glow-line"></div>

        <section class="clubs-section" id="section-clubs">
            <div class="section-title">🏫 School Clubs Directory</div>
            <div class="clubs-grid">
                <div class="club-card" style="--card-color1: #ff6b6b; --card-color2: #ee5a24; --card-shadow: rgba(255,107,107,0.3);">
                    <span class="club-icon">🎵</span>
                    <div class="club-name">Music Club</div>
                    <div class="club-desc">Harmonies, rhythms & live performances across campus</div>
                    <div class="club-members">👥 124 Members</div>
                </div>
                <div class="club-card" style="--card-color1: #fd79a8; --card-color2: #e84393; --card-shadow: rgba(253,121,168,0.3);">
                    <span class="club-icon">🎨</span>
                    <div class="club-name">Art Club</div>
                    <div class="club-desc">Painting, sculpture, digital art & creative exhibitions</div>
                    <div class="club-members">👥 98 Members</div>
                </div>
                <div class="club-card" style="--card-color1: #00f0ff; --card-color2: #0984e3; --card-shadow: rgba(0,240,255,0.3);">
                    <span class="club-icon">💻</span>
                    <div class="club-name">ICT Club</div>
                    <div class="club-desc">Coding, robotics, cybersecurity & tech innovation</div>
                    <div class="club-members">👥 156 Members</div>
                </div>
                <div class="club-card" style="--card-color1: #ffeaa7; --card-color2: #fdcb6e; --card-shadow: rgba(253,203,110,0.3);">
                    <span class="club-icon">🎭</span>
                    <div class="club-name">Drama Club</div>
                    <div class="club-desc">Theatre, acting workshops & stage productions</div>
                    <div class="club-members">👥 87 Members</div>
                </div>
                <div class="club-card" style="--card-color1: #55efc4; --card-color2: #00b894; --card-shadow: rgba(85,239,196,0.3);">
                    <span class="club-icon">🗣️</span>
                    <div class="club-name">Debate Club</div>
                    <div class="club-desc">Public speaking, argumentation & competitive debating</div>
                    <div class="club-members">👥 112 Members</div>
                </div>
                <div class="club-card" style="--card-color1: #a29bfe; --card-color2: #6c5ce7; --card-shadow: rgba(162,155,254,0.3);">
                    <span class="club-icon">🇫🇷</span>
                    <div class="club-name">French Club</div>
                    <div class="club-desc">Language immersion, culture & Francophone events</div>
                    <div class="club-members">👥 76 Members</div>
                </div>
                <div class="club-card" style="--card-color1: #fab1a0; --card-color2: #e17055; --card-shadow: rgba(250,177,160,0.3);">
                    <span class="club-icon">📚</span>
                    <div class="club-name">Literary Club</div>
                    <div class="club-desc">Creative writing, poetry, book reviews & storytelling</div>
                    <div class="club-members">👥 68 Members</div>
                </div>
                <div class="club-card" style="--card-color1: #74b9ff; --card-color2: #0984e3; --card-shadow: rgba(116,185,255,0.3);">
                    <span class="club-icon">⚽</span>
                    <div class="club-name">Sports Club</div>
                    <div class="club-desc">Athletics, team sports, fitness & school tournaments</div>
                    <div class="club-members">👥 203 Members</div>
                </div>
                <div class="club-card" style="--card-color1: #dfe6e9; --card-color2: #b2bec3; --card-shadow: rgba(178,190,195,0.3);">
                    <span class="club-icon">🔬</span>
                    <div class="club-name">Science Club</div>
                    <div class="club-desc">Experiments, research projects & science fairs</div>
                    <div class="club-members">👥 134 Members</div>
                </div>
                <div class="club-card" style="--card-color1: #ff9ff3; --card-color2: #f368e0; --card-shadow: rgba(255,159,243,0.3);">
                    <span class="club-icon">📸</span>
                    <div class="club-name">Photography Club</div>
                    <div class="club-desc">Visual storytelling, photo walks & darkroom techniques</div>
                    <div class="club-members">👥 91 Members</div>
                </div>
            </div>
        </section>

        <div class="glow-line"></div>

        <section class="features-section" id="section-features">
            <div class="section-title">⚡ System Features</div>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">📊</div>
                    <div class="feature-title">Smart Dashboard</div>
                    <div class="feature-desc">Real-time analytics on club activities, attendance trends, event participation, and member engagement metrics all in one view.</div>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📅</div>
                    <div class="feature-title">Event Scheduler</div>
                    <div class="feature-desc">AI-powered scheduling that prevents conflicts, optimizes venue usage, and automatically sends reminders to all members.</div>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">👥</div>
                    <div class="feature-title">Member Portal</div>
                    <div class="feature-desc">Self-service registration, profile management, attendance tracking, and inter-club communication channels.</div>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">💰</div>
                    <div class="feature-title">Budget Tracker</div>
                    <div class="feature-desc">Transparent financial management with expense approval workflows, fundraising tracking, and automated reports for administrators.</div>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🏆</div>
                    <div class="feature-title">Achievement System</div>
                    <div class="feature-desc">Gamified badges, leaderboards, and recognition for active members and outstanding clubs across the school year.</div>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📱</div>
                    <div class="feature-title">Mobile Ready</div>
                    <div class="feature-desc">Fully responsive design with push notifications so students and staff can stay connected from any device, anywhere on campus.</div>
                </div>
            </div>
        </section>

        <div class="bottom-cta" id="section-cta">
            <div class="glow-line" style="max-width:400px;margin:0 auto 40px;"></div>
            <div style="font-family:'Orbitron',sans-serif;font-size:clamp(1rem,2.5vw,1.5rem);margin-bottom:15px;color:rgba(255,255,255,0.7);">Ready to Transform Your School Clubs?</div>
            <div style="font-size:0.9rem;color:rgba(255,255,255,0.35);margin-bottom:35px;max-width:500px;display:inline-block;">
                Join the future of club management. Simplify, organize, and empower every student community on campus.
            </div>
            <br>
            <button class="cta-btn" onclick="window.location.href='/auth/login'">
                🚀 Get Started Now
            </button>
            <div class="glow-line" style="max-width:400px;margin:40px auto 0;"></div>
        </div>
    </div>



    <div class="nav-dots">
        <div class="nav-dot active" onclick="scrollToSection('section-home')" title="Home"></div>
        <div class="nav-dot" onclick="scrollToSection('section-clubs')" title="Clubs"></div>
        <div class="nav-dot" onclick="scrollToSection('section-features')" title="Features"></div>
        <div class="nav-dot" onclick="scrollToSection('section-cta')" title="Get Started"></div>
    </div>

    <div class="scroll-indicator" id="scrollIndicator" onclick="scrollToSection('section-clubs')">▼</div>

    <div class="particle-info">WebGL 3D • Three.js</div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        // === LOADING SCREEN ===
        window.addEventListener('load', () => {
            setTimeout(() => {
                document.getElementById('loadingScreen').classList.add('hidden');
            }, 1500);
        });

        // === THREE.JS 3D SCENE ===
        let scene, camera, renderer, mainCube, cornerSpheres, floatingRings, particles;
        let mouseX = 0, mouseY = 0;
        let clock;

        function init3D() {
            const container = document.getElementById('canvas-container');
            clock = new THREE.Clock();

            // Scene
            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x0a0a1a, 0.008);

            // Camera
            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 0, 30);

            // Renderer
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.setClearColor(0x0a0a1a, 1);
            container.appendChild(renderer.domElement);

            // Lights
            const ambientLight = new THREE.AmbientLight(0x222244, 0.5);
            scene.add(ambientLight);

            const pointLight1 = new THREE.PointLight(0x00f0ff, 2, 60);
            pointLight1.position.set(10, 10, 10);
            scene.add(pointLight1);

            const pointLight2 = new THREE.PointLight(0x7b2ff7, 2, 60);
            pointLight2.position.set(-10, -10, 10);
            scene.add(pointLight2);

            const pointLight3 = new THREE.PointLight(0xff2daa, 1, 40);
            pointLight3.position.set(0, 15, -10);
            scene.add(pointLight3);

            // === MAIN CUBE (holographic wireframe) ===
            const cubeGeom = new THREE.BoxGeometry(8, 8, 8);
            const cubeEdges = new THREE.EdgesGeometry(cubeGeom);
            const cubeMat = new THREE.LineBasicMaterial({ color: 0x00f0ff, transparent: true, opacity: 0.6 });
            mainCube = new THREE.LineSegments(cubeEdges, cubeMat);
            scene.add(mainCube);

            // Inner cube
            const innerCubeGeom = new THREE.BoxGeometry(5, 5, 5);
            const innerEdges = new THREE.EdgesGeometry(innerCubeGeom);
            const innerMat = new THREE.LineBasicMaterial({ color: 0x7b2ff7, transparent: true, opacity: 0.4 });
            const innerCube = new THREE.LineSegments(innerEdges, innerMat);
            mainCube.add(innerCube);
            innerCube.rotation.set(Math.PI/4, Math.PI/4, 0);

            // Innermost cube
            const smallestCubeGeom = new THREE.BoxGeometry(2.5, 2.5, 2.5);
            const smallestEdges = new THREE.EdgesGeometry(smallestCubeGeom);
            const smallestMat = new THREE.LineBasicMaterial({ color: 0xff2daa, transparent: true, opacity: 0.3 });
            const smallestCube = new THREE.LineSegments(smallestEdges, smallestMat);
            mainCube.add(smallestCube);
            smallestCube.rotation.set(0, Math.PI/4, Math.PI/4);

            // === CORNER SPHERES ===
            cornerSpheres = [];
            const corners = [
                [-4,-4,-4],[4,-4,-4],[-4,4,-4],[4,4,-4],
                [-4,-4,4],[4,-4,4],[-4,4,4],[4,4,4]
            ];
            const sphereColors = [0x00f0ff, 0x7b2ff7, 0xff2daa, 0x55efc4, 0xffeaa7, 0xfd79a8, 0x74b9ff, 0xa29bfe];

            corners.forEach((pos, i) => {
                const sphereGeom = new THREE.SphereGeometry(0.35, 16, 16);
                const sphereMat = new THREE.MeshPhongMaterial({
                    color: sphereColors[i],
                    emissive: sphereColors[i],
                    emissiveIntensity: 0.5,
                    transparent: true,
                    opacity: 0.9
                });
                const sphere = new THREE.Mesh(sphereGeom, sphereMat);
                sphere.position.set(pos[0], pos[1], pos[2]);
                mainCube.add(sphere);
                cornerSpheres.push(sphere);

                // Glow
                const glowGeom = new THREE.SphereGeometry(0.6, 16, 16);
                const glowMat = new THREE.MeshBasicMaterial({
                    color: sphereColors[i],
                    transparent: true,
                    opacity: 0.15
                });
                const glow = new THREE.Mesh(glowGeom, glowMat);
                sphere.add(glow);
            });

            // === CONNECTING LINES BETWEEN CORNERS ===
            const lineConnections = [
                [0,1],[2,3],[4,5],[6,7],
                [0,2],[1,3],[4,6],[5,7],
                [0,4],[1,5],[2,6],[3,7]
            ];
            lineConnections.forEach(([a,b]) => {
                const points = [
                    new THREE.Vector3(corners[a][0], corners[a][1], corners[a][2]),
                    new THREE.Vector3(corners[b][0], corners[b][1], corners[b][2])
                ];
                const lineGeom = new THREE.BufferGeometry().setFromPoints(points);
                const lineMat = new THREE.LineBasicMaterial({ color: 0x00f0ff, transparent: true, opacity: 0.15 });
                const line = new THREE.Line(lineGeom, lineMat);
                mainCube.add(line);
            });

            // === FLOATING RINGS ===
            floatingRings = [];
            const ringData = [
                { radius: 12, tube: 0.04, color: 0x00f0ff, speed: 0.3, tilt: 0.3 },
                { radius: 14, tube: 0.03, color: 0x7b2ff7, speed: -0.2, tilt: -0.5 },
                { radius: 16, tube: 0.03, color: 0xff2daa, speed: 0.15, tilt: 0.8 },
                { radius: 10, tube: 0.05, color: 0x55efc4, speed: -0.4, tilt: -0.2 }
            ];

            ringData.forEach(rd => {
                const ringGeom = new THREE.TorusGeometry(rd.radius, rd.tube, 16, 100);
                const ringMat = new THREE.MeshBasicMaterial({ color: rd.color, transparent: true, opacity: 0.3 });
                const ring = new THREE.Mesh(ringGeom, ringMat);
                ring.rotation.x = rd.tilt;
                ring.rotation.y = rd.tilt * 0.5;
                ring.userData = { speed: rd.speed };
                scene.add(ring);
                floatingRings.push(ring);
            });

            // === FLOATING CLUB ICONS (3D text planes) ===
            const clubLabels = ['♪', '✦', '⚡', '★', '◆', '❀'];
            const labelColors = [0xff6b6b, 0xfd79a8, 0x00f0ff, 0xffeaa7, 0x55efc4, 0xa29bfe];

            clubLabels.forEach((label, i) => {
                const canvas = document.createElement('canvas');
                canvas.width = 128;
                canvas.height = 128;
                const ctx = canvas.getContext('2d');
                ctx.fillStyle = 'transparent';
                ctx.fillRect(0, 0, 128, 128);
                ctx.font = 'bold 72px Arial';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                const color = new THREE.Color(labelColors[i]);
                ctx.fillStyle = `rgb(${Math.floor(color.r*255)},${Math.floor(color.g*255)},${Math.floor(color.b*255)})`;
                ctx.fillText(label, 64, 64);

                const texture = new THREE.CanvasTexture(canvas);
                const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: true, opacity: 0.6 });
                const sprite = new THREE.Sprite(spriteMat);

                const angle = (i / clubLabels.length) * Math.PI * 2;
                const radius = 18 + Math.random() * 5;
                sprite.position.set(
                    Math.cos(angle) * radius,
                    (Math.random() - 0.5) * 12,
                    Math.sin(angle) * radius
                );
                sprite.scale.set(2.5, 2.5, 1);
                sprite.userData = { angle: angle, radius: radius, yBase: sprite.position.y, speed: 0.2 + Math.random() * 0.3 };
                scene.add(sprite);
            });

            // === PARTICLES ===
            const particleCount = 2000;
            const particleGeom = new THREE.BufferGeometry();
            const positions = new Float32Array(particleCount * 3);
            const colors = new Float32Array(particleCount * 3);
            const sizes = new Float32Array(particleCount);

            const colorPalette = [
                new THREE.Color(0x00f0ff),
                new THREE.Color(0x7b2ff7),
                new THREE.Color(0xff2daa),
                new THREE.Color(0x55efc4),
                new THREE.Color(0xffeaa7)
            ];

            for (let i = 0; i < particleCount; i++) {
                positions[i * 3] = (Math.random() - 0.5) * 100;
                positions[i * 3 + 1] = (Math.random() - 0.5) * 100;
                positions[i * 3 + 2] = (Math.random() - 0.5) * 100;

                const color = colorPalette[Math.floor(Math.random() * colorPalette.length)];
                colors[i * 3] = color.r;
                colors[i * 3 + 1] = color.g;
                colors[i * 3 + 2] = color.b;

                sizes[i] = Math.random() * 2 + 0.5;
            }

            particleGeom.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            particleGeom.setAttribute('color', new THREE.BufferAttribute(colors, 3));
            particleGeom.setAttribute('size', new THREE.BufferAttribute(sizes, 1));

            // Create a simple circle texture for particles
            const pCanvas = document.createElement('canvas');
            pCanvas.width = 64;
            pCanvas.height = 64;
            const pCtx = pCanvas.getContext('2d');
            const gradient = pCtx.createRadialGradient(32, 32, 0, 32, 32, 32);
            gradient.addColorStop(0, 'rgba(255,255,255,1)');
            gradient.addColorStop(0.3, 'rgba(255,255,255,0.5)');
            gradient.addColorStop(1, 'rgba(255,255,255,0)');
            pCtx.fillStyle = gradient;
            pCtx.fillRect(0, 0, 64, 64);
            const pTexture = new THREE.CanvasTexture(pCanvas);

            const particleMat = new THREE.PointsMaterial({
                size: 0.4,
                map: pTexture,
                transparent: true,
                opacity: 0.6,
                vertexColors: true,
                blending: THREE.AdditiveBlending,
                depthWrite: false,
                sizeAttenuation: true
            });

            particles = new THREE.Points(particleGeom, particleMat);
            scene.add(particles);

            // === GRID FLOOR ===
            const gridHelper = new THREE.GridHelper(80, 40, 0x111133, 0x111133);
            gridHelper.position.y = -15;
            gridHelper.material.transparent = true;
            gridHelper.material.opacity = 0.3;
            scene.add(gridHelper);

            // === HEXAGON FLOATING PLATFORMS ===
            for (let i = 0; i < 6; i++) {
                const hexGeom = new THREE.CylinderGeometry(1.5 + Math.random(), 1.5 + Math.random(), 0.15, 6);
                const hexMat = new THREE.MeshPhongMaterial({
                    color: colorPalette[i % colorPalette.length],
                    emissive: colorPalette[i % colorPalette.length],
                    emissiveIntensity: 0.2,
                    transparent: true,
                    opacity: 0.25,
                    wireframe: false
                });
                const hex = new THREE.Mesh(hexGeom, hexMat);
                const angle = (i / 6) * Math.PI * 2;
                hex.position.set(Math.cos(angle) * 20, (Math.random()-0.5) * 10, Math.sin(angle) * 20);
                hex.rotation.y = Math.random() * Math.PI;
                hex.userData = { angle: angle, speed: 0.1 + Math.random() * 0.2, yBase: hex.position.y };
                scene.add(hex);
            }

            // Mouse / Touch
            document.addEventListener('mousemove', (e) => {
                mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
                mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
            });

            document.addEventListener('touchmove', (e) => {
                if (e.touches.length > 0) {
                    mouseX = (e.touches[0].clientX / window.innerWidth - 0.5) * 2;
                    mouseY = (e.touches[0].clientY / window.innerHeight - 0.5) * 2;
                }
            });

            window.addEventListener('resize', onResize);
        }

        function onResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);
            const time = clock.getElapsedTime();
            const delta = clock.getDelta();

            // Rotate main cube
            mainCube.rotation.x = time * 0.15 + mouseY * 0.3;
            mainCube.rotation.y = time * 0.2 + mouseX * 0.3;
            mainCube.rotation.z = Math.sin(time * 0.1) * 0.1;

            // Pulse corner spheres
            cornerSpheres.forEach((sphere, i) => {
                const scale = 1 + Math.sin(time * 2 + i * 0.8) * 0.3;
                sphere.scale.set(scale, scale, scale);
                sphere.material.emissiveIntensity = 0.3 + Math.sin(time * 3 + i) * 0.3;
            });

            // Rotate rings
            floatingRings.forEach(ring => {
                ring.rotation.z += ring.userData.speed * 0.01;
                ring.rotation.x += ring.userData.speed * 0.005;
            });

            // Rotate particles slowly
            particles.rotation.y = time * 0.02;
            particles.rotation.x = Math.sin(time * 0.01) * 0.1;

            // Animate hexagons and sprites
            scene.children.forEach(child => {
                if (child.userData && child.userData.speed !== undefined && child !== mainCube) {
                    if (child.userData.angle !== undefined) {
                        child.userData.angle += child.userData.speed * 0.005;
                        const r = child.userData.radius || 20;
                        child.position.x = Math.cos(child.userData.angle) * r;
                        child.position.z = Math.sin(child.userData.angle) * r;
                        if (child.userData.yBase !== undefined) {
                            child.position.y = child.userData.yBase + Math.sin(time * child.userData.speed * 2) * 2;
                        }
                    }
                }
            });

            // Camera subtle movement
            camera.position.x += (mouseX * 3 - camera.position.x) * 0.02;
            camera.position.y += (-mouseY * 2 - camera.position.y) * 0.02;
            camera.lookAt(0, 0, 0);

            // Scroll-based camera zoom
            const scrollY = window.scrollY;
            const maxScroll = document.body.scrollHeight - window.innerHeight;
            const scrollProgress = maxScroll > 0 ? scrollY / maxScroll : 0;
            camera.position.z = 30 + scrollProgress * 15;
            camera.fov = 60 - scrollProgress * 10;
            camera.updateProjectionMatrix();

            renderer.render(scene, camera);
        }

        // === COUNTER ANIMATION ===
        function animateCounter(id, target, suffix = '') {
            const el = document.getElementById(id);
            let current = 0;
            const increment = target / 80;
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    current = target;
                    clearInterval(timer);
                }
                el.textContent = Math.floor(current) + suffix;
            }, 20);
        }

        // === NAV DOTS ===
        function scrollToSection(id) {
            document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
        }

        function updateNavDots() {
            const sections = ['section-home', 'section-clubs', 'section-features', 'section-cta'];
            const dots = document.querySelectorAll('.nav-dot');
            const scrollY = window.scrollY + window.innerHeight / 3;

            sections.forEach((id, i) => {
                const section = document.getElementById(id);
                if (section) {
                    const top = section.offsetTop;
                    const bottom = top + section.offsetHeight;
                    if (scrollY >= top && scrollY < bottom) {
                        dots.forEach(d => d.classList.remove('active'));
                        if (dots[i]) dots[i].classList.add('active');
                    }
                }
            });

            // Scroll indicator
            const indicator = document.getElementById('scrollIndicator');
            if (window.scrollY > 200) {
                indicator.classList.add('hidden');
            } else {
                indicator.classList.remove('hidden');
            }
        }

        window.addEventListener('scroll', updateNavDots);

        // === CLUB CARD TILT EFFECT ===
        document.querySelectorAll('.club-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                const rotateX = (y - centerY) / centerY * -8;
                const rotateY = (x - centerX) / centerX * 8;
                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-15px) scale(1.05)`;
            });

            card.addEventListener('mouseleave', () => {
                card.style.transform = '';
            });

            card.addEventListener('click', () => {
                card.style.transition = 'transform 0.1s';
                card.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    card.style.transition = '';
                    card.style.transform = '';
                    scrollToSection('section-cta');
                }, 150);
            });
        });

        // === INIT ===
        init3D();
        animate();

        // Start counters after a delay
        setTimeout(() => {
            animateCounter('stat1', Number('<%= totalClubs %>'), '+');
            animateCounter('stat2', Number('<%= totalMemberships %>'), '+');
            animateCounter('stat3', Number('<%= totalActivities %>'), '+');
            animateCounter('stat4', Number('<%= satisfaction %>'), '%');
        }, 2000);
    </script>
</body>
</html>