```ejs
<%- include('../partials/header') %>

<div class="app-layout-container">

    <%- include('../partials/sidebar') %>

    <div class="main-content-window">

        <%- include('../partials/navbar') %>

        <main class="workspace-viewport">

            <!-- ==========================================
                 FLASH MESSAGES
            ========================================== -->

            <% if (typeof success_msg !== 'undefined' && success_msg) { %>

                <div
                    class="alert alert-success"
                    style="
                        padding:12px 16px;
                        border-radius:8px;
                        background:rgba(16,185,129,.12);
                        color:#10B981;
                        margin-bottom:20px;
                    "
                >
                    <i class="fas fa-check-circle"></i>
                    <%= success_msg %>
                </div>

            <% } %>


            <% if (typeof error_msg !== 'undefined' && error_msg) { %>

                <div
                    class="alert alert-danger"
                    style="
                        padding:12px 16px;
                        border-radius:8px;
                        background:rgba(239,68,68,.12);
                        color:#EF4444;
                        margin-bottom:20px;
                    "
                >
                    <i class="fas fa-exclamation-circle"></i>
                    <%= error_msg %>
                </div>

            <% } %>


            <!-- ==========================================
                 PAGE HEADER
            ========================================== -->

            <div class="page-header-actions">

                <div class="header-text-block">

                    <h2>System Settings</h2>

                    <p>
                        Configure school information, branding,
                        and system preferences.
                    </p>

                </div>

                <button
                    class="btn btn-primary"
                    id="darkModeBtn"
                    type="button"
                >
                    <i class="fas fa-adjust"></i>
                    Toggle Theme
                </button>

            </div>


            <div class="settings-grid">


                <!-- ==========================================
                     SCHOOL PROFILE
                ========================================== -->

                <section
                    class="settings-card"
                    style="grid-column:1/-1;"
                >

                    <h3>
                        <i class="fas fa-school"></i>
                        School Profile
                    </h3>

                    <p>
                        Update the school information displayed
                        throughout the Smart Club Management System.
                    </p>


                    <form
                        action="/settings/profile"
                        method="POST"
                        style="margin-top:20px;"
                    >

                        <div
                            style="
                                display:grid;
                                grid-template-columns:
                                repeat(auto-fit,minmax(280px,1fr));
                                gap:16px;
                            "
                        >


                            <!-- SCHOOL NAME -->

                            <div class="form-group">

                                <label>
                                    School Name *
                                </label>

                                <input
                                    type="text"
                                    name="school_name"
                                    class="form-control"
                                    value="<%= settings.school_name || '' %>"
                                    placeholder="Enter school name"
                                    required
                                >

                            </div>


                            <!-- SCHOOL MOTTO -->

                            <div class="form-group">

                                <label>
                                    School Motto
                                </label>

                                <input
                                    type="text"
                                    name="school_motto"
                                    class="form-control"
                                    value="<%= settings.school_motto || '' %>"
                                    placeholder="Enter school motto"
                                >

                            </div>


                            <!-- ADDRESS -->

                            <div class="form-group">

                                <label>
                                    Address
                                </label>

                                <input
                                    type="text"
                                    name="school_address"
                                    class="form-control"
                                    value="<%= settings.school_address || '' %>"
                                    placeholder="School address"
                                >

                            </div>


                            <!-- PHONE -->

                            <div class="form-group">

                                <label>
                                    Phone
                                </label>

                                <input
                                    type="text"
                                    name="school_phone"
                                    class="form-control"
                                    value="<%= settings.school_phone || '' %>"
                                    placeholder="School phone number"
                                >

                            </div>


                            <!-- EMAIL -->

                            <div class="form-group">

                                <label>
                                    Email
                                </label>

                                <input
                                    type="email"
                                    name="school_email"
                                    class="form-control"
                                    value="<%= settings.school_email || '' %>"
                                    placeholder="School email"
                                >

                            </div>


                            <!-- WEBSITE -->

                            <div class="form-group">

                                <label>
                                    Website
                                </label>

                                <input
                                    type="text"
                                    name="school_website"
                                    class="form-control"
                                    value="<%= settings.school_website || '' %>"
                                    placeholder="https://example.com"
                                >

                            </div>

                        </div>


                        <div
                            class="form-action-footer-row"
                            style="margin-top:20px;"
                        >

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >

                                <i class="fas fa-save"></i>
                                Save Profile

                            </button>

                        </div>

                    </form>

                </section>



                <!-- ==========================================
                     SCHOOL BRANDING
                ========================================== -->

                <section class="settings-card">

                    <h3>
                        <i class="fas fa-palette"></i>
                        School Branding
                    </h3>

                    <p>
                        Upload the school logo used across
                        the system.
                    </p>


                    <div
                        style="
                            display:flex;
                            align-items:center;
                            gap:20px;
                            margin-top:20px;
                            flex-wrap:wrap;
                        "
                    >


                        <!-- LOGO PREVIEW -->

                        <div
                            style="
                                width:90px;
                                height:90px;
                                border-radius:12px;
                                overflow:hidden;
                                background:rgba(59,130,246,.1);
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                border:2px dashed rgba(59,130,246,.3);
                            "
                        >

                            <% if (settings.school_logo) { %>

                                <img
                                    src="<%= settings.school_logo %>"
                                    alt="School Logo"
                                    style="
                                        width:100%;
                                        height:100%;
                                        object-fit:cover;
                                    "
                                >

                            <% } else { %>

                                <i
                                    class="fas fa-graduation-cap"
                                    style="
                                        font-size:32px;
                                        color:#60a5fa;
                                    "
                                ></i>

                            <% } %>

                        </div>


                        <!-- LOGO FORM -->

                        <form
                            action="/settings/logo"
                            method="POST"
                            enctype="multipart/form-data"
                            style="
                                flex:1;
                                min-width:250px;
                            "
                        >

                            <div class="form-group">

                                <label>
                                    School Logo
                                </label>

                                <input
                                    type="file"
                                    name="school_logo"
                                    class="form-control"
                                    accept=".jpg,.jpeg,.png,.gif,.webp"
                                    required
                                >

                                <small
                                    style="
                                        display:block;
                                        margin-top:6px;
                                        opacity:.7;
                                    "
                                >
                                    JPG, JPEG, PNG, GIF or WEBP.
                                    Maximum size: 2MB.
                                </small>

                            </div>


                            <button
                                type="submit"
                                class="btn btn-secondary btn-sm"
                            >

                                <i class="fas fa-upload"></i>
                                Upload Logo

                            </button>

                        </form>

                    </div>

                </section>



                <!-- ==========================================
                     SYSTEM PREFERENCES
                ========================================== -->

                <section class="settings-card">

                    <h3>
                        <i class="fas fa-sliders-h"></i>
                        System Preferences
                    </h3>

                    <p>
                        Configure the default currency,
                        academic year and system theme.
                    </p>


                    <form
                        action="/settings/preferences"
                        method="POST"
                        style="margin-top:20px;"
                    >

                        <div
                            style="
                                display:grid;
                                grid-template-columns:
                                repeat(auto-fit,minmax(220px,1fr));
                                gap:16px;
                            "
                        >


                            <!-- CURRENCY -->

                            <div class="form-group">

                                <label>
                                    Default Currency
                                </label>

                                <select
                                    name="currency"
                                    class="form-control"
                                >

                                    <option
                                        value="KES"
                                        <%= settings.currency === 'KES'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        KES — Kenyan Shilling
                                    </option>

                                    <option
                                        value="USD"
                                        <%= settings.currency === 'USD'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        USD — US Dollar
                                    </option>

                                    <option
                                        value="GBP"
                                        <%= settings.currency === 'GBP'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        GBP — British Pound
                                    </option>

                                    <option
                                        value="EUR"
                                        <%= settings.currency === 'EUR'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        EUR — Euro
                                    </option>

                                    <option
                                        value="UGX"
                                        <%= settings.currency === 'UGX'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        UGX — Ugandan Shilling
                                    </option>

                                    <option
                                        value="TZS"
                                        <%= settings.currency === 'TZS'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        TZS — Tanzanian Shilling
                                    </option>

                                    <option
                                        value="NGN"
                                        <%= settings.currency === 'NGN'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        NGN — Nigerian Naira
                                    </option>

                                    <option
                                        value="ZAR"
                                        <%= settings.currency === 'ZAR'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        ZAR — South African Rand
                                    </option>

                                </select>

                            </div>


                            <!-- ACADEMIC YEAR -->

                            <div class="form-group">

                                <label>
                                    Academic Year
                                </label>

                                <input
                                    type="text"
                                    name="academic_year"
                                    class="form-control"
                                    value="<%= settings.academic_year || '' %>"
                                    placeholder="e.g. 2026"
                                >

                            </div>


                            <!-- THEME -->

                            <div class="form-group">

                                <label>
                                    System Theme
                                </label>

                                <select
                                    name="theme"
                                    class="form-control"
                                >

                                    <option
                                        value="Professional"
                                        <%= !settings.theme ||
                                            settings.theme === 'Professional'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        Professional
                                    </option>

                                    <option
                                        value="Modern"
                                        <%= settings.theme === 'Modern'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        Modern
                                    </option>

                                    <option
                                        value="Classic"
                                        <%= settings.theme === 'Classic'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        Classic
                                    </option>

                                </select>

                            </div>

                        </div>


                        <div
                            class="form-action-footer-row"
                            style="margin-top:20px;"
                        >

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >

                                <i class="fas fa-save"></i>
                                Save Preferences

                            </button>

                        </div>

                    </form>

                </section>



                <!-- ==========================================
                     APPEARANCE
                ========================================== -->

                <section class="settings-card">

                    <h3>
                        <i class="fas fa-palette"></i>
                        Appearance
                    </h3>

                    <p>
                        Control the visual experience of
                        the administration portal.
                    </p>


                    <div class="setting-row">

                        <div>

                            <strong>
                                Default Theme
                            </strong>

                            <span>
                                Professional dark-blue command theme
                                with accent highlights.
                            </span>

                        </div>

                        <span class="toggle-pill">
                            Active
                        </span>

                    </div>


                    <div class="setting-row">

                        <div>

                            <strong>
                                Readable Text
                            </strong>

                            <span>
                                High contrast text across tables,
                                cards, forms and badges.
                            </span>

                        </div>

                        <span class="toggle-pill">
                            On
                        </span>

                    </div>


                    <div class="setting-row">

                        <div>

                            <strong>
                                Animations
                            </strong>

                            <span>
                                Smooth hover transitions and
                                interface micro-interactions.
                            </span>

                        </div>

                        <span class="toggle-pill">
                            On
                        </span>

                    </div>

                </section>



                <!-- ==========================================
                     SECURITY & ACCESS
                ========================================== -->

                <section class="settings-card">

                    <h3>
                        <i class="fas fa-shield-alt"></i>
                        Security & Access
                    </h3>

                    <p>
                        Current access controls for the
                        administration portal.
                    </p>


                    <div class="setting-row">

                        <div>

                            <strong>
                                Session Security
                            </strong>

                            <span>
                                Protected pages require an
                                authenticated user session.
                            </span>

                        </div>

                        <span class="toggle-pill">
                            Enabled
                        </span>

                    </div>


                    <div class="setting-row">

                        <div>

                            <strong>
                                Admin Access
                            </strong>

                            <span>
                                Administrators have monitoring
                                and configuration access.
                            </span>

                        </div>

                        <span class="toggle-pill">
                            View Only
                        </span>

                    </div>


                    <div class="setting-row">

                        <div>

                            <strong>
                                Session Duration
                            </strong>

                            <span>
                                Login sessions last 24 hours.
                            </span>

                        </div>

                        <span class="toggle-pill">
                            24h
                        </span>

                    </div>

                </section>



                <!-- ==========================================
                     ADMIN QUICK ACCESS
                ========================================== -->

                <section class="settings-card">

                    <h3>
                        <i class="fas fa-eye"></i>
                        Admin Monitoring
                    </h3>

                    <p>
                        Administrators can monitor the system
                        without performing operational changes.
                    </p>


                    <div class="setting-row">

                        <div>

                            <strong>
                                System Overview
                            </strong>

                            <span>
                                View clubs, students, memberships,
                                activities and system statistics.
                            </span>

                        </div>

                        <a
                            href="/admin/dashboard"
                            class="btn btn-primary btn-sm"
                        >
                            <i class="fas fa-chart-line"></i>
                            View Dashboard
                        </a>

                    </div>


                    <div class="setting-row">

                        <div>

                            <strong>
                                Reports
                            </strong>

                            <span>
                                Review system reports and
                                activity information.
                            </span>

                        </div>

                        <a
                            href="/reports"
                            class="btn btn-muted btn-sm"
                        >
                            <i class="fas fa-file-alt"></i>
                            View Reports
                        </a>

                    </div>

                </section>



                <!-- ==========================================
                     SYSTEM INFORMATION
                ========================================== -->

                <section class="settings-card">

                    <h3>
                        <i class="fas fa-info-circle"></i>
                        System Information
                    </h3>

                    <p>
                        Platform and technical information
                        about the school management system.
                    </p>


                    <div class="setting-row">

                        <div>

                            <strong>
                                Platform
                            </strong>

                            <span>
                                <%= settings.school_name ||
                                    'Smart Club System' %>
                                Smart Club System
                            </span>

                        </div>

                        <span
                            class="toggle-pill"
                            style="
                                background:rgba(59,130,246,.14)
                                !important;
                                color:#60a5fa !important;
                            "
                        >
                            v2.0
                        </span>

                    </div>


                    <div class="setting-row">

                        <div>

                            <strong>
                                Framework
                            </strong>

                            <span>
                                Node.js + Express + EJS + MySQL
                            </span>

                        </div>

                    </div>


                    <div class="setting-row">

                        <div>

                            <strong>
                                Database
                            </strong>

                            <span>
                                MySQL with connection pooling
                            </span>

                        </div>

                        <span class="toggle-pill">
                            Connected
                        </span>

                    </div>

                </section>

            </div>

        </main>

        <%- include('../partials/footer') %>

    </div>

</div>

