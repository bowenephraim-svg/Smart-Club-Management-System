<%- include('../partials/header') %>
<div class="app-layout-container">
    <%- include('../partials/sidebar') %>
    
    <div class="main-content-window">
        <%- include('../partials/navbar') %>
        
        <main class="workspace-viewport">
            <div class="back-navigation-row">
                <a href="/clubs" class="back-link"><i class="fas fa-arrow-left"></i> Return to Clubs Matrix</a>
            </div>

            <div class="form-workspace-card">
                <div class="form-card-header">
                    <h3>Charter New Club Organization</h3>
                    <p>Initialize global workspace constraints, categorize operational profiles, and assign dedicated staff mentors.</p>
                </div>

                <form action="/clubs/add" method="POST" class="standard-system-form">
                    <div class="form-grid-two-columns">
                        <div class="input-field-wrapper">
                            <label for="club_name">Official Club Designation Title <span class="required">*</span></label>
                            <input type="text" id="club_name" name="club_name" placeholder="e.g. Aeronautical Software Group" required>
                        </div>

                        <div class="input-field-wrapper">
                            <label for="category">Operational Framework Category <span class="required">*</span></label>
                            <select id="category" name="category" required>
                                <option value="" disabled selected>Select taxonomy grouping...</option>
                                <option value="Technology & STEM">Technology & STEM</option>
                                <option value="Arts & Creative Design">Arts & Creative Design</option>
                                <option value="Leadership & Debate">Leadership & Debate</option>
                                <option value="Sports & Athletics">Sports & Athletics</option>
                                <option value="Environmental Action">Environmental Action</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-grid-two-columns">
                        <div class="input-field-wrapper">
                            <label for="patron_id">Assigned Faculty Supervisor Oversight</label>
                            <select id="patron_id" name="patron_id">
                                <option value="">-- Leave Vacant / Unassigned --</option>
                                <% if (patrons && patrons.length > 0) { %>
                                    <% patrons.forEach(patron => { %>
                                        <option value="<%= patron.patron_id %>"><%= patron.first_name %> <%= patron.last_name %> (<%= patron.department %>)</option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>

                        <div class="input-field-wrapper">
                            <label for="capacity">Maximum User Member Volumetric Capacity <span class="required">*</span></label>
                            <input type="number" id="capacity" name="capacity" value="30" min="5" max="150" required>
                        </div>
                    </div>

                    <div class="input-field-wrapper">
                        <label for="status">Initial Initialization Status State</label>
                        <select id="status" name="status">
                            <option value="Active" selected>Active / Open for Enrollment</option>
                            <option value="Suspended">Suspended / Operational Freeze</option>
                        </select>
                    </div>

                    <div class="input-field-wrapper">
                        <label for="description">Charter Objectives Manifesto Summary</label>
                        <textarea id="description" name="description" rows="4" placeholder="Detail the core objectives, timeline constraints, and structural benchmarks of this club..."></textarea>
                    </div>

                    <div class="form-action-footer-row">
                        <a href="/clubs" class="btn btn-muted">Cancel Setup Sequence</a>
                        <button type="submit" class="btn btn-primary">Publish Club Charter</button>
                    </div>
                </form>
            </div>
        </main>
        
        <%- include('../partials/footer') %>
    </div>
</div>