<%- include('../partials/header') %>

<%- include('../partials/sidebar') %>

<div class="main-content-window">

    <%- include('../partials/navbar') %>

    <main class="workspace-viewport">

        <div class="page-header-actions">
            <div class="header-text-block">
                <h2>
                    <i class="fas fa-user-check" style="color:var(--primary-color);margin-right:8px;"></i>
                    Pending Student Registrations
                </h2>
                <p>Review students who have completed registration.</p>
            </div>
            <a href="/patron/dashboard" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Dashboard
            </a>
        </div>

        <% if (typeof success_msg !== 'undefined' && success_msg) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> <%= success_msg %>
            <button type="button" class="alert-close-btn" aria-label="Close">&times;</button>
        </div>
        <% } %>

        <% if (typeof error_msg !== 'undefined' && error_msg) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> <%= error_msg %>
            <button type="button" class="alert-close-btn" aria-label="Close">&times;</button>
        </div>
        <% } %>

        <div class="table-card-container" style="margin-top:1rem;">

            <% if (!students || students.length === 0) { %>

                <div style="text-align:center;padding:3.5rem 1rem;color:var(--text-muted);">
                    <i class="fas fa-check-circle" style="font-size:3.5rem;opacity:.35;display:block;margin-bottom:1rem;color:var(--success);"></i>
                    <h4 style="color:var(--text-secondary);margin-bottom:.5rem;">No Pending Registrations</h4>
                    <p style="font-size:.9rem;">All student registrations have been reviewed.</p>
                </div>

            <% } else { %>

                <div class="table-responsive-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Admission No.</th>
                                <th>Student</th>
                                <th>Email</th>
                                <th>Class</th>
                                <th>Registered</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach(student => { %>
                                <tr>
                                    <td><strong><%= student.admission_no %></strong></td>
                                    <td><%= student.first_name %> <%= student.last_name %></td>
                                    <td><%= student.email %></td>
                                    <td><%= student.class || '-' %> <%= student.stream || '' %></td>
                                    <td><%= new Date(student.created_at).toLocaleDateString('en-GB') %></td>
                                    <td>
                                        <form method="POST" action="/patron/student-registrations/approve/<%= student.user_id %>" style="display:inline;">
                                            <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Approve this student registration?')">
                                                <i class="fas fa-check"></i> Approve
                                            </button>
                                        </form>
                                        <form method="POST" action="/patron/student-registrations/reject/<%= student.user_id %>" style="display:inline;margin-left:6px;">
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Reject this student registration?')">
                                                <i class="fas fa-times"></i> Reject
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

            <% } %>

        </div>

    </main>

    <%- include('../partials/footer') %>

</div>
