<%- include('../partials/header', { pageTitle: pageTitle || 'Patron Dashboard' }) %>

<%- include('../partials/sidebar') %>

<div class="main-content-window">

    <%- include('../partials/navbar') %>

    <main class="workspace-viewport">

        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->
        <div class="page-header-actions">
            <div class="header-text-block">
                <h2><i class="fas fa-user-tie" style="color:var(--primary-color);margin-right:8px;"></i> Patron Dashboard</h2>
                <p>Manage your assigned club(s), members, activities and events.</p>
            </div>
        </div>

        <!-- =====================================================
             FLASH MESSAGES
        ====================================================== -->
        <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> <%= success_msg %>
            <button type="button" class="alert-close-btn" aria-label="Close">&times;</button>
        </div>
        <% } %>

        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> <%= error_msg %>
            <button type="button" class="alert-close-btn" aria-label="Close">&times;</button>
        </div>
        <% } %>

        <div class="dashboard-content">

            <!-- =====================================================
                 WELCOME BANNER
            ====================================================== -->
            <div class="welcome-card patron-welcome">
                <div class="welcome-content">
                    <div>
                        <h2>
                            Welcome back, <%= patron && patron.full_name ? patron.full_name.replace(/^(mr|mrs|ms|miss|dr|prof)\.?\s+/i, '') : 'Patron' %> 👋
                        </h2>
                        <p>Patron Dashboard &mdash; Smart Club Management System</p>
                        <span class="welcome-date">
                            <i class="fas fa-calendar-alt"></i>
                            <%= new Date().toLocaleDateString('en-GB', {
                                weekday: 'long',
                                day: 'numeric',
                                month: 'long',
                                year: 'numeric'
                            }) %>
                        </span>
                        <% if (patron && patron.department) { %>
                        <span class="welcome-date" style="margin-left:1rem;">
                            <i class="fas fa-building"></i>
                            <%= patron.department %>
                        </span>
                        <% } %>
                    </div>

                    <div class="welcome-buttons">
                        <a href="/patron/clubs" class="btn btn-primary">
                            <i class="fas fa-users"></i> My Clubs
                        </a>
                        <a href="/patron/members" class="btn btn-warning">
                            <i class="fas fa-id-card"></i> Members
                        </a>
                        <a href="/activities" class="btn btn-success">
                            <i class="fas fa-calendar-alt"></i> Activities
                        </a>
                    </div>
                </div>
            </div>

            <!-- =====================================================
                 STATS GRID
            ====================================================== -->
            <div class="dashboard-stats-grid">

                <!-- My Members -->
                <div class="stat-card info">
                    <div class="stat-content">
                        <div class="stat-left">
                            <span>My Club Members</span>
                            <h2><%= stats && stats.totalMembers != null ? stats.totalMembers : 0 %></h2>
                            <small class="stat-change">
                                <i class="fas fa-user-check"></i> Active Members
                            </small>
                        </div>
                        <div class="stat-icon-wrapper">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>

                <!-- Pending Requests -->
                <div class="stat-card warning">
                    <div class="stat-content">
                        <div class="stat-left">
                            <span>Pending Requests</span>
                            <h2><%= stats && stats.pendingRequests != null ? stats.pendingRequests : 0 %></h2>
                            <small class="stat-change">
                                <i class="fas fa-hourglass-half"></i> Awaiting Approval
                            </small>
                        </div>
                        <div class="stat-icon-wrapper">
                            <i class="fas fa-user-clock"></i>
                        </div>
                    </div>
                </div>

                <!-- Upcoming Activities -->
                <div class="stat-card success">
                    <div class="stat-content">
                        <div class="stat-left">
                            <span>Upcoming Activities</span>
                            <h2><%= stats && stats.upcomingActivities != null ? stats.upcomingActivities : 0 %></h2>
                            <small class="stat-change">
                                <i class="fas fa-calendar-plus"></i> Scheduled
                            </small>
                        </div>
                        <div class="stat-icon-wrapper">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                    </div>
                </div>

                <!-- Attendance Rate -->
                <div class="stat-card danger">
                    <div class="stat-content">
                        <div class="stat-left">
                            <span>Attendance Rate</span>
                            <h2><%= attendance && attendance.rate != null ? attendance.rate : 0 %>%</h2>
                            <small class="stat-change">
                                <i class="fas fa-clipboard-check"></i>
                                <%= attendance && attendance.present != null ? attendance.present : 0 %> Present /
                                <%= attendance && attendance.total  != null ? attendance.total  : 0 %> Total
                            </small>
                        </div>
                        <div class="stat-icon-wrapper">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                    </div>
                </div>

            </div>
            <!-- /stats-grid -->

            <!-- =====================================================
                 MY CLUBS
            ====================================================== -->
            <div class="table-card-container" style="margin-top:1.5rem;">
                <div class="table-controls-bar">
                    <h3 class="table-title-heading">
                        <i class="fas fa-users"></i> My Assigned Club(s)
                    </h3>
                    <a href="/patron/clubs" class="btn btn-primary btn-sm">View All Clubs</a>
                </div>

                <% if (clubs && clubs.length > 0) { %>
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.25rem;padding:1.25rem;">
                    <% clubs.forEach(function(club) { %>
                    <div class="patron-club-card" style="background:var(--surface);border-radius:var(--radius-md);padding:1.25rem;border:1px solid var(--border);box-shadow:var(--shadow-sm);transition:transform .2s,box-shadow .2s;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='var(--shadow-md)'" onmouseout="this.style.transform='';this.style.boxShadow='var(--shadow-sm)'">

                        <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.75rem;">
                            <div style="width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--secondary));display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fas fa-users" style="color:#fff;font-size:1.1rem;"></i>
                            </div>
                            <div>
                                <h4 style="margin:0;font-size:1rem;font-weight:700;color:var(--text-main);"><%= club.club_name %></h4>
                                <% if (club.venue) { %>
                                <small style="color:var(--text-muted);"><i class="fas fa-map-marker-alt"></i> <%= club.venue %></small>
                                <% } %>
                            </div>
                        </div>

                        <% if (club.description) { %>
                        <p style="font-size:.85rem;color:var(--text-secondary);margin:0 0 .75rem 0;line-height:1.5;"><%= club.description.length > 100 ? club.description.substring(0, 100) + '...' : club.description %></p>
                        <% } %>

                        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                            <span style="font-size:.8rem;background:var(--primary-soft);color:var(--primary);padding:.25rem .6rem;border-radius:999px;font-weight:600;">
                                <i class="fas fa-user-check"></i> <%= club.active_member_count || 0 %> Active
                            </span>
                            <% if (Number(club.pending_member_count) > 0) { %>
                            <span style="font-size:.8rem;background:rgba(245,158,11,.12);color:var(--warning);padding:.25rem .6rem;border-radius:999px;font-weight:600;">
                                <i class="fas fa-hourglass-half"></i> <%= club.pending_member_count %> Pending
                            </span>
                            <% } %>
                            <% if (club.meeting_day) { %>
                            <span style="font-size:.8rem;background:var(--secondary-soft);color:var(--secondary);padding:.25rem .6rem;border-radius:999px;font-weight:600;">
                                <i class="fas fa-calendar-day"></i> <%= club.meeting_day %>
                            </span>
                            <% } %>
                        </div>

                        <div style="margin-top:.85rem;display:flex;gap:.5rem;">
                            <a href="/patron/members" class="btn btn-primary btn-sm" style="font-size:.78rem;padding:.3rem .65rem;">
                                <i class="fas fa-id-card"></i> Members
                            </a>
                            <a href="/activities" class="btn btn-secondary btn-sm" style="font-size:.78rem;padding:.3rem .65rem;">
                                <i class="fas fa-calendar-alt"></i> Activities
                            </a>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } else { %>
                <div style="text-align:center;padding:3rem 1rem;color:var(--text-muted);">
                    <i class="fas fa-users" style="font-size:3rem;opacity:.3;display:block;margin-bottom:1rem;"></i>
                    <h4 style="color:var(--text-secondary);margin-bottom:.5rem;">No Club Assigned Yet</h4>
                    <p style="font-size:.9rem;">No club has been assigned to you yet. Please contact the Administrator.</p>
                </div>
                <% } %>
            </div>
            <a
    href="/patron/student-registrations"
    class="btn btn-primary"
>
    <i class="fas fa-user-check"></i>
    Student Registrations
</a>


<a
    href="/patron/membership-requests"
    class="btn btn-warning"
>
    <i class="fas fa-users"></i>
    Membership Requests
</a>

            <!-- =====================================================
                 SPLIT LAYOUT: MEMBERS + PENDING REQUESTS
            ====================================================== -->
            <div class="dashboard-split-layout" style="display:grid;grid-template-columns:1.5fr 1fr;gap:1.5rem;margin-top:1.5rem;">

                <!-- RECENT MEMBERS -->
                <div class="table-card-container">
                    <div class="table-controls-bar">
                        <h3 class="table-title-heading">
                            <i class="fas fa-user-check"></i> Recent Members
                        </h3>
                        <a href="/patron/members" class="btn btn-primary btn-sm">View All</a>
                    </div>
                    <div class="table-responsive-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Admission</th>
                                    <th>Name</th>
                                    <th>Class</th>
                                    <th>Club</th>
                                    <th>Role</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (members && members.length > 0) { %>
                                    <% members.forEach(function(m) { %>
                                    <tr>
                                        <td><strong><%= m.admission_no %></strong></td>
                                        <td><%= m.first_name %> <%= m.last_name %></td>
                                        <td><%= m.class || '—' %></td>
                                        <td><%= m.club_name %></td>
                                        <td>
                                            <span class="status-badge <%= m.club_role === 'Member' ? 'status-active' : 'status-info' %>">
                                                <%= m.club_role %>
                                            </span>
                                        </td>
                                        <td><%= m.join_date ? new Date(m.join_date).toLocaleDateString('en-GB') : '—' %></td>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" style="text-align:center;color:var(--text-muted);padding:2rem;">
                                            <i class="fas fa-user-slash" style="display:block;font-size:1.5rem;margin-bottom:.5rem;opacity:.4;"></i>
                                            No active members found.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- PENDING MEMBERSHIP REQUESTS -->
                <div class="table-card-container">
                    <div class="table-controls-bar">
                        <h3 class="table-title-heading">
                            <i class="fas fa-hourglass-half"></i> Pending Requests
                        </h3>
                        <a href="/patron/membership-requests" class="btn btn-warning btn-sm">View All</a>
                    </div>
                    <div class="table-responsive-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Admission</th>
                                    <th>Student</th>
                                    <th>Club</th>
                                    <th>Requested</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (pendingMemberships && pendingMemberships.length > 0) { %>
                                    <% pendingMemberships.slice(0, 8).forEach(function(pm) { %>
                                    <tr>
                                        <td><strong><%= pm.admission_no %></strong></td>
                                        <td><%= pm.student_name %></td>
                                        <td><%= pm.club_name %></td>
                                        <td><%= pm.join_date ? new Date(pm.join_date).toLocaleDateString('en-GB') : '—' %></td>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" style="text-align:center;color:var(--text-muted);padding:2rem;">
                                            <i class="fas fa-check-circle" style="display:block;font-size:1.5rem;margin-bottom:.5rem;opacity:.4;color:var(--success);"></i>
                                            No pending requests.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <% if (pendingMemberships && pendingMemberships.length > 0) { %>
                    <div style="padding:.75rem 1rem;border-top:1px solid var(--border);">
                        <small style="color:var(--text-muted);">Membership approvals are managed by the Administrator. Contact admin to approve or reject requests.</small>
                    </div>
                    <% } %>
                </div>

            </div>

            <!-- =====================================================
                 UPCOMING EVENTS
            ====================================================== -->
            <div class="table-card-container" style="margin-top:1.5rem;">
                <div class="table-controls-bar">
                    <h3 class="table-title-heading">
                        <i class="fas fa-calendar-check"></i> Upcoming Events
                    </h3>
                    <a href="/events" class="btn btn-primary btn-sm">View All Events</a>
                </div>
                <div class="table-responsive-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Club</th>
                                <th>Date</th>
                                <th>Venue</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof upcomingEvents !== 'undefined' && upcomingEvents && upcomingEvents.length > 0) { %>
                                <% upcomingEvents.forEach(function(ev) { %>
                                <tr>
                                    <td>
                                        <strong><%= ev.activity_name %></strong>
                                        <% if (ev.description) { %>
                                        <br><small style="color:var(--text-muted)"><%= ev.description.length > 60 ? ev.description.substring(0,60) + '...' : ev.description %></small>
                                        <% } %>
                                    </td>
                                    <td><%= ev.club_name %></td>
                                    <td><%= ev.activity_date ? new Date(ev.activity_date).toLocaleDateString('en-GB') : '—' %></td>
                                    <td><%= ev.venue || '—' %></td>
                                    <td>
                                        <span class="status-badge <%= ev.status === 'Today' ? 'status-warning' : (ev.status === 'Completed' ? 'status-inactive' : 'status-active') %>">
                                            <%= ev.status %>
                                        </span>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" style="text-align:center;color:var(--text-muted);padding:2rem;">
                                        <i class="fas fa-calendar-times" style="display:block;font-size:1.5rem;margin-bottom:.5rem;opacity:.4;"></i>
                                        No upcoming events scheduled.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- =====================================================
                 SPLIT LAYOUT: ACHIEVEMENTS + NOTIFICATIONS
            ====================================================== -->
            <div class="table-card-container" style="margin-top:1.5rem;">
                <div class="table-controls-bar">
                    <h3 class="table-title-heading">
                        <i class="fas fa-calendar-alt"></i> Upcoming Activities
                    </h3>
                    <a href="/activities" class="btn btn-primary btn-sm">View All</a>
                </div>
                <div class="table-responsive-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Activity</th>
                                <th>Club</th>
                                <th>Date</th>
                                <th>Venue</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (upcomingActivities && upcomingActivities.length > 0) { %>
                                <% upcomingActivities.forEach(function(act) { %>
                                <tr>
                                    <td>
                                        <strong><%= act.activity_name %></strong>
                                        <% if (act.description) { %>
                                        <br><small style="color:var(--text-muted)"><%= act.description.length > 60 ? act.description.substring(0,60) + '...' : act.description %></small>
                                        <% } %>
                                    </td>
                                    <td><%= act.club_name %></td>
                                    <td><%= act.activity_date ? new Date(act.activity_date).toLocaleDateString('en-GB') : '—' %></td>
                                    <td><%= act.venue || '—' %></td>
                                    <td>
                                        <span class="status-badge <%= act.status === 'Today' ? 'status-warning' : (act.status === 'Completed' ? 'status-inactive' : 'status-active') %>">
                                            <%= act.status %>
                                        </span>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" style="text-align:center;color:var(--text-muted);padding:2rem;">
                                        <i class="fas fa-calendar-times" style="display:block;font-size:1.5rem;margin-bottom:.5rem;opacity:.4;"></i>
                                        No upcoming activities scheduled.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- =====================================================
                 SPLIT LAYOUT: ACHIEVEMENTS + NOTIFICATIONS
            ====================================================== -->
            <div class="dashboard-split-layout" style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:1.5rem;">

                <!-- RECENT ACHIEVEMENTS -->
                <div class="table-card-container">
                    <div class="table-controls-bar">
                        <h3 class="table-title-heading">
                            <i class="fas fa-trophy"></i> Recent Achievements
                        </h3>
                        <a href="/achievements" class="btn btn-primary btn-sm">View All</a>
                    </div>

                    <% if (achievements && achievements.length > 0) { %>
                    <div style="padding:1rem;display:flex;flex-direction:column;gap:.75rem;">
                        <% achievements.forEach(function(a) { %>
                        <div style="display:flex;gap:.75rem;align-items:flex-start;padding:.75rem;background:var(--surface-alt);border-radius:var(--radius-sm);border-left:3px solid var(--accent);">
                            <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#f59e0b,#d97706);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fas fa-medal" style="color:#fff;font-size:.9rem;"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <p style="margin:0;font-weight:600;font-size:.9rem;color:var(--text-main);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= a.title %></p>
                                <small style="color:var(--text-muted);">
                                    <% if (a.student_name && a.student_name.trim() !== '') { %><%= a.student_name %> &bull; <% } %>
                                    <%= a.club_name %>
                                    <% if (a.achievement_date) { %> &bull; <%= new Date(a.achievement_date).toLocaleDateString('en-GB') %><% } %>
                                </small>
                                <% if (a.category) { %>
                                <br><span style="font-size:.72rem;background:rgba(245,158,11,.12);color:var(--accent);padding:.15rem .5rem;border-radius:999px;font-weight:600;"><%= a.category %></span>
                                <% } %>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                    <% } else { %>
                    <div style="text-align:center;padding:2.5rem 1rem;color:var(--text-muted);">
                        <i class="fas fa-trophy" style="font-size:2rem;opacity:.25;display:block;margin-bottom:.75rem;"></i>
                        <p style="font-size:.9rem;">No achievements recorded yet.</p>
                    </div>
                    <% } %>
                </div>

                <!-- RECENT NOTIFICATIONS -->
                <div class="table-card-container">
                    <div class="table-controls-bar">
                        <h3 class="table-title-heading">
                            <i class="fas fa-bell"></i> Notifications
                        </h3>
                        <a href="/patron/notifications" class="btn btn-secondary btn-sm">View All</a>
                    </div>

                    <% if (notifications && notifications.length > 0) { %>
                    <div style="padding:1rem;display:flex;flex-direction:column;gap:.65rem;max-height:380px;overflow-y:auto;">
                        <% notifications.forEach(function(n) { %>
                        <div style="display:flex;gap:.65rem;align-items:flex-start;padding:.65rem .75rem;background:<%= n.status === 'Unread' ? 'rgba(37,99,235,.05)' : 'var(--surface-alt)' %>;border-radius:var(--radius-sm);border-left:3px solid <%= n.status === 'Unread' ? 'var(--primary)' : 'var(--border)' %>;">
                            <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--secondary));display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fas fa-bell" style="color:#fff;font-size:.75rem;"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <p style="margin:0;font-size:.85rem;color:var(--text-main);font-weight:<%= n.status === 'Unread' ? '600' : '400' %>;"><%= n.message %></p>
                                <small style="color:var(--text-muted);">
                                    <%= new Date(n.created_at).toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
                                </small>
                            </div>
                            <% if (n.status === 'Unread') { %>
                            <span style="width:8px;height:8px;border-radius:50%;background:var(--primary);flex-shrink:0;margin-top:4px;"></span>
                            <% } %>
                        </div>
                        <% }); %>
                    </div>
                    <% } else { %>
                    <div style="text-align:center;padding:2.5rem 1rem;color:var(--text-muted);">
                        <i class="fas fa-bell-slash" style="font-size:2rem;opacity:.25;display:block;margin-bottom:.75rem;"></i>
                        <p style="font-size:.9rem;">No notifications yet.</p>
                    </div>
                    <% } %>
                </div>

            </div>
            <!-- /split achievements + notifications -->

            <!-- =====================================================
                 ATTENDANCE SUMMARY
            ====================================================== -->
            <% if (attendance && attendance.total > 0) { %>
            <div class="table-card-container" style="margin-top:1.5rem;">
                <div class="table-controls-bar">
                    <h3 class="table-title-heading">
                        <i class="fas fa-clipboard-check"></i> Attendance Summary
                    </h3>
                    <a href="/attendance" class="btn btn-primary btn-sm">Manage Attendance</a>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;padding:1.25rem;">
                    <div style="text-align:center;padding:1.25rem;background:var(--surface-alt);border-radius:var(--radius-md);border:1px solid var(--border);">
                        <div style="font-size:2rem;font-weight:700;color:var(--success);"><%= attendance.present %></div>
                        <div style="color:var(--text-muted);font-size:.85rem;margin-top:.25rem;"><i class="fas fa-check-circle" style="color:var(--success);"></i> Present</div>
                    </div>
                    <div style="text-align:center;padding:1.25rem;background:var(--surface-alt);border-radius:var(--radius-md);border:1px solid var(--border);">
                        <div style="font-size:2rem;font-weight:700;color:var(--danger);"><%= attendance.absent %></div>
                        <div style="color:var(--text-muted);font-size:.85rem;margin-top:.25rem;"><i class="fas fa-times-circle" style="color:var(--danger);"></i> Absent</div>
                    </div>
                    <div style="text-align:center;padding:1.25rem;background:var(--surface-alt);border-radius:var(--radius-md);border:1px solid var(--border);">
                        <div style="font-size:2rem;font-weight:700;color:var(--info);"><%= attendance.total %></div>
                        <div style="color:var(--text-muted);font-size:.85rem;margin-top:.25rem;"><i class="fas fa-users" style="color:var(--info);"></i> Total Records</div>
                    </div>
                    <div style="text-align:center;padding:1.25rem;background:linear-gradient(135deg,var(--primary),var(--secondary));border-radius:var(--radius-md);">
                        <div style="font-size:2rem;font-weight:700;color:#fff;"><%= attendance.rate %>%</div>
                        <div style="color:rgba(255,255,255,.8);font-size:.85rem;margin-top:.25rem;"><i class="fas fa-chart-pie"></i> Attendance Rate</div>
                        <!-- Simple progress bar -->
                        <div style="margin-top:.65rem;background:rgba(255,255,255,.25);border-radius:999px;height:6px;">
                            <div style="background:#fff;border-radius:999px;height:6px;width:<%= attendance.rate %>%;transition:width .5s ease;"></div>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- =====================================================
                 QUICK ACTIONS
            ====================================================== -->
            <div class="quick-actions" style="margin-top:1.5rem;">
                <div class="dashboard-grid">

                    <a href="/clubs" class="quick-card">
                        <i class="fas fa-users"></i>
                        <h4>My Clubs</h4>
                        <p>View and manage your assigned clubs.</p>
                    </a>

                    <a href="/patron/members" class="quick-card">
                        <i class="fas fa-id-card"></i>
                        <h4>Members</h4>
                        <p>View current club membership roster.</p>
                    </a>

                    <a href="/activities" class="quick-card">
                        <i class="fas fa-calendar-alt"></i>
                        <h4>Activities</h4>
                        <p>Browse and manage club activities.</p>
                    </a>

                    <a href="/attendance" class="quick-card">
                        <i class="fas fa-clipboard-check"></i>
                        <h4>Attendance</h4>
                        <p>Track member attendance records.</p>
                    </a>

                    <a href="/events" class="quick-card">
                        <i class="fas fa-calendar-check"></i>
                        <h4>Events</h4>
                        <p>View upcoming club events.</p>
                    </a>

                    <a href="/achievements" class="quick-card">
                        <i class="fas fa-trophy"></i>
                        <h4>Achievements</h4>
                        <p>View club and student achievements.</p>
                    </a>

                    <a href="/patron/notifications" class="quick-card">
                        <i class="fas fa-bell"></i>
                        <h4>Notifications</h4>
                        <p>Check your latest notifications.</p>
                        <% if (stats && stats.unreadNotifications > 0) { %>
                        <span style="position:absolute;top:.75rem;right:.75rem;background:var(--danger);color:#fff;font-size:.7rem;padding:.2rem .5rem;border-radius:999px;font-weight:700;"><%= stats.unreadNotifications %></span>
                        <% } %>
                    </a>

                    <a href="/patron/profile" class="quick-card">
                        <i class="fas fa-user-circle"></i>
                        <h4>My Profile</h4>
                        <p>View your patron profile details.</p>
                    </a>

                </div>
            </div>

        </div>
        <!-- /dashboard-content -->

    </main>

</div>

<%- include('../partials/footer') %>
