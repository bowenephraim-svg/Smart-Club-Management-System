<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Student Elections |
        <%= schoolSettings
            ? (schoolSettings.school_name || 'Smart Club System')
            : 'Smart Club System'
        %>
    </title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <!-- Student Portal Styling -->
    <link
        rel="stylesheet"
        href="/css/student.css"
    >

    <!-- Central Design System -->
    <link
        rel="stylesheet"
        href="/css/design-system.css"
    >

</head>


<body>

<div class="student-layout">


    <!-- =====================================================
         STUDENT SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <!-- Logo -->

        <div class="logo">

            <h4>
                <%= schoolSettings
                    ? (schoolSettings.school_name || 'Smart Club System')
                    : 'Smart Club System'
                %>
            </h4>

            <small>
                Student Portal
            </small>

        </div>


        <!-- Navigation -->

        <ul>

            <!-- Dashboard -->

            <li>

                <a href="/student/dashboard">

                    <i class="bi bi-speedometer2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>

            </li>


            <!-- My Clubs -->

            <li>

                <a href="/student/clubs">

                    <i class="bi bi-people"></i>

                    <span>
                        My Clubs
                    </span>

                </a>

            </li>


            <!-- Join Club -->

            <li>

                <a href="/student/clubs/available">

                    <i class="bi bi-plus-circle"></i>

                    <span>
                        Join a Club
                    </span>

                </a>

            </li>


            <!-- Payments -->

            <li>

                <a href="/student/payments">

                    <i class="bi bi-cash-stack"></i>

                    <span>
                        My Payments
                    </span>

                </a>

            </li>


            <!-- Events -->

            <li>

                <a href="/student/events">

                    <i class="bi bi-calendar-event"></i>

                    <span>
                        Events
                    </span>

                </a>

            </li>


            <!-- Attendance -->

            <li>

                <a href="/student/attendance">

                    <i class="bi bi-check2-square"></i>

                    <span>
                        Attendance
                    </span>

                </a>

            </li>


            <!-- Notifications -->

            <li>

                <a href="/student/notifications">

                    <i class="bi bi-bell"></i>

                    <span>
                        Notifications
                    </span>

                </a>

            </li>


            <!-- Elections -->

            <li class="active">

                <a href="/elections/available">

                    <i class="bi bi-check2-square"></i>

                    <span>
                        Elections
                    </span>

                </a>

            </li>


            <!-- Profile -->

            <li>

                <a href="/student/profile">

                    <i class="bi bi-person-circle"></i>

                    <span>
                        My Profile
                    </span>

                </a>

            </li>


            <!-- Logout -->

            <li>

                <a href="/auth/logout">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </li>

        </ul>

    </aside>



    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="content">


        <!-- =================================================
             TOP NAVBAR
        ================================================== -->

        <%- include('../partials/student-navbar', {
    pageTitle: 'Student Elections'
         }) %>



        <!-- =================================================
             PAGE HEADER
        ================================================== -->

        <div class="welcome-card">

            <div>

                <h2>

                    <i class="bi bi-check2-square"></i>

                    Student Elections

                </h2>

                <p>

                    View available elections, check candidates,
                    and cast your vote when an election is open.

                </p>

            </div>

        </div>



        <!-- =================================================
             FLASH MESSAGES
        ================================================== -->

        <% if (typeof success_msg !== 'undefined' && success_msg) { %>

            <div
                class="alert alert-success alert-dismissible fade show"
                role="alert"
            >

                <i class="bi bi-check-circle-fill me-2"></i>

                <%= success_msg %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% } %>


        <% if (typeof error_msg !== 'undefined' && error_msg) { %>

            <div
                class="alert alert-danger alert-dismissible fade show"
                role="alert"
            >

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                <%= error_msg %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% } %>



        <!-- =================================================
             NOT STUDENT STATE
        ================================================== -->

        <% if (notStudent) { %>

            <div class="section">

                <div class="text-center py-5">

                    <i
                        class="bi bi-person-x"
                        style="font-size: 55px;"
                    ></i>

                    <h4 class="mt-3">
                        Student Access Required
                    </h4>

                    <p class="text-muted">

                        Elections are available only to
                        registered students.

                    </p>

                </div>

            </div>


        <% } else { %>



            <!-- =================================================
                 ACTIVE ELECTIONS
            ================================================== -->

            <div class="section">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h4>

                            <i class="bi bi-lightning-charge-fill me-2"></i>

                            Active Elections

                        </h4>

                        <p class="text-muted mb-0">

                            Elections currently open for voting.

                        </p>

                    </div>

                </div>



                <% if (
                    activeElections &&
                    activeElections.length > 0
                ) { %>


                    <div class="row g-4">

                        <% activeElections.forEach(election => { %>

                            <div class="col-md-6 col-xl-4">

                                <div class="card h-100 shadow-sm border-0">

                                    <div class="card-body d-flex flex-column">


                                        <!-- Election Icon -->

                                        <div
                                            class="mb-3"
                                            style="font-size: 35px;"
                                        >

                                            <i class="bi bi-ballot-check"></i>

                                        </div>


                                        <!-- Election Name -->

                                        <h5 class="card-title fw-bold">

                                            <%= election.title ||
                                                election.election_name ||
                                                'School Election'
                                            %>

                                        </h5>


                                        <!-- Club -->

                                        <% if (election.club_name) { %>

                                            <p class="text-muted mb-2">

                                                <i class="bi bi-people me-1"></i>

                                                <%= election.club_name %>

                                            </p>

                                        <% } %>


                                        <!-- Description -->

                                        <% if (election.description) { %>

                                            <p class="text-muted">

                                                <%= election.description %>

                                            </p>

                                        <% } %>


                                        <!-- Dates -->

                                        <div class="small text-muted mb-3">

                                            <% if (election.start_date) { %>

                                                <div>

                                                    <i class="bi bi-calendar-event me-1"></i>

                                                    Starts:
                                                    <%= election.start_date %>

                                                </div>

                                            <% } %>


                                            <% if (election.end_date) { %>

                                                <div>

                                                    <i class="bi bi-calendar-check me-1"></i>

                                                    Ends:
                                                    <%= election.end_date %>

                                                </div>

                                            <% } %>

                                        </div>


                                        <div class="mt-auto">


                                            <% if (
                                                votedElectionIds &&
                                                votedElectionIds.includes(
                                                    election.election_id
                                                )
                                            ) { %>


                                                <button
                                                    class="btn btn-secondary w-100"
                                                    disabled
                                                >

                                                    <i class="bi bi-check-circle me-1"></i>

                                                    Vote Submitted

                                                </button>


                                            <% } else { %>


                                                <a
                                                    href="/elections/vote/<%= election.election_id %>"
                                                    class="btn btn-primary w-100"
                                                >

                                                    <i class="bi bi-check2-square me-1"></i>

                                                    Vote Now

                                                </a>


                                            <% } %>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        <% }) %>

                    </div>


                <% } else { %>


                    <div class="text-center py-5">

                        <i
                            class="bi bi-calendar-x"
                            style="font-size: 50px;"
                        ></i>

                        <h5 class="mt-3">
                            No Active Elections
                        </h5>

                        <p class="text-muted">

                            There are currently no elections
                            open for voting.

                        </p>

                    </div>


                <% } %>

            </div>



            <!-- =================================================
                 ALL ELECTIONS
            ================================================== -->

            <div class="section mt-4">

                <div class="mb-4">

                    <h4>

                        <i class="bi bi-list-check me-2"></i>

                        Election History

                    </h4>

                    <p class="text-muted mb-0">

                        View previous and upcoming elections.

                    </p>

                </div>


                <% if (
                    allElections &&
                    allElections.length > 0
                ) { %>


                    <div class="table-responsive">

                        <table class="table align-middle">

                            <thead>

                                <tr>

                                    <th>
                                        Election
                                    </th>

                                    <th>
                                        Club
                                    </th>

                                    <th>
                                        Start
                                    </th>

                                    <th>
                                        End
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <% allElections.forEach(election => { %>

                                    <tr>

                                        <td>

                                            <strong>

                                                <%= election.title ||
                                                    election.election_name ||
                                                    'Election'
                                                %>

                                            </strong>

                                        </td>


                                        <td>

                                            <%= election.club_name || '-' %>

                                        </td>


                                        <td>

                                            <%= election.start_date || '-' %>

                                        </td>


                                        <td>

                                            <%= election.end_date || '-' %>

                                        </td>


                                        <td>

                                            <% if (
                                                election.status === 'Active'
                                            ) { %>

                                                <span class="badge bg-success">

                                                    Active

                                                </span>

                                            <% } else if (
                                                election.status === 'Upcoming'
                                            ) { %>

                                                <span class="badge bg-warning text-dark">

                                                    Upcoming

                                                </span>

                                            <% } else if (
                                                election.status === 'Closed'
                                            ) { %>

                                                <span class="badge bg-secondary">

                                                    Closed

                                                </span>

                                            <% } else { %>

                                                <span class="badge bg-light text-dark">

                                                    <%= election.status || 'Unknown' %>

                                                </span>

                                            <% } %>

                                        </td>


                                        <td>

                                            <% if (
                                                votedElectionIds &&
                                                votedElectionIds.includes(
                                                    election.election_id
                                                )
                                            ) { %>

                                                <span class="text-success">

                                                    <i class="bi bi-check-circle"></i>

                                                    Voted

                                                </span>

                                            <% } else if (
                                                election.status === 'Active'
                                            ) { %>

                                                    <a
                                                        href="/elections/vote/<%= election.election_id %>"
                                                        class="btn btn-sm btn-primary"
                                                    >

                                                    Vote

                                                </a>

                                            <% } else { %>

                                                <span class="text-muted">

                                                    —

                                                </span>

                                            <% } %>

                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>


                <% } else { %>


                    <div class="text-center py-5">

                        <i
                            class="bi bi-inbox"
                            style="font-size: 50px;"
                        ></i>

                        <h5 class="mt-3">

                            No Elections Found

                        </h5>

                        <p class="text-muted">

                            Election records will appear here
                            when they become available.

                        </p>

                    </div>


                <% } %>

            </div>


        <% } %>


    </main>

</div>



<!-- Bootstrap JS -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
></script>


<script src="/js/theme.js"></script>
</body>

</html>