<%- include('../partials/header') %>
<div class="app-layout-container">
    <%- include('../partials/sidebar') %>

    <div class="main-content-window">
        <%- include('../partials/navbar') %>

        <main class="workspace-viewport">
            <div class="back-navigation-row">
                <a href="/elections" class="back-link"><i class="fas fa-arrow-left"></i> Return to Elections</a>
            </div>

            <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success_msg %></div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                <div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i> <%= error_msg %></div>
            <% } %>

            <div class="form-workspace-card">
                <div class="form-card-header">
                    <h3><%= pageTitle || 'Election Details' %></h3>
                    <p>Set the election title, club, date, and status. The election status controls when students can vote.</p>
                </div>

                <form action="<%= action %>" method="POST" class="standard-system-form">
                    <div class="form-grid-two-columns">
                        <div class="input-field-wrapper">
                            <label for="club_id">Club <span class="required">*</span></label>
                            <select id="club_id" name="club_id" required>
                                <option value="" disabled <%= !formData.club_id ? 'selected' : '' %>>Select a club...</option>
                                <% if (clubs && clubs.length > 0) { %>
                                    <% clubs.forEach(club => { %>
                                        <option value="<%= club.club_id %>" <%= String(formData.club_id) === String(club.club_id) ? 'selected' : '' %>><%= club.club_name %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>

                        <div class="input-field-wrapper">
                            <label for="title">Election Title <span class="required">*</span></label>
                            <input type="text" id="title" name="title" value="<%= formData.title || '' %>" placeholder="e.g. Debate Club Leadership Elections 2026" required>
                        </div>
                    </div>

                    <div class="form-grid-two-columns">
                        <div class="input-field-wrapper">
                            <label for="election_date">Election Date <span class="required">*</span></label>
                            <input type="date" id="election_date" name="election_date" value="<%= formData.election_date || '' %>" required>
                        </div>

                        <div class="input-field-wrapper">
                            <label for="status">Status <span class="required">*</span></label>
                            <select id="status" name="status" required>
                                <option value="Upcoming" <%= String(formData.status || 'Upcoming') === 'Upcoming' ? 'selected' : '' %>>Upcoming</option>
                                <option value="Open" <%= String(formData.status) === 'Open' ? 'selected' : '' %>>Open (Active)</option>
                                <option value="Closed" <%= String(formData.status) === 'Closed' ? 'selected' : '' %>>Closed</option>
                            </select>
                        </div>
                    </div>

                    <div class="input-field-wrapper">
                        <label for="description">Description</label>
                        <textarea id="description" name="description" rows="4" placeholder="Add a short description of the election and the positions contested..."><%= formData.description || '' %></textarea>
                    </div>

                    <div class="form-action-footer-row">
                        <a href="/elections" class="btn btn-muted">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= submitLabel || 'Save Election' %></button>
                    </div>
                </form>
            </div>
        </main>

        <%- include('../partials/footer') %>
    </div>
</div>